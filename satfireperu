function viirs(d,s){

    const t4 =
        Number(
            d.bright_ti4
        );

    const t5 =
        Number(
            d.bright_ti5
        );

    const x = {

        ...d,

        latitude:
            Number(
                d.latitude
            ),

        longitude:
            Number(
                d.longitude
            ),

        frp:
            Number(
                d.frp
            ),

        t4,
        t5,

        deltaT:
            t4 - t5,

        confidenceNormalizada:
            String(
                d.confidence ?? ""
            )
            .toLowerCase()
            .trim(),

        source:
            s.id

    };

    return normalizarSensor(
        x,
        "VIIRS"
    );

}


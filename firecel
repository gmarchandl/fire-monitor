function formatFechaHoraPeru(v){

    if(v === null || v === undefined || v === "")
        return "N/D";

    let d = null;

    if(typeof v === "number" || /^\d{10,13}$/.test(String(v).trim())){
        const n = Number(v);
        d = new Date(String(v).trim().length === 10 ? n * 1000 : n);
    }
    else{
        const s = String(v).trim();

        if(/^\d{4}-\d{2}-\d{2}$/.test(s)){
            return s;
        }
        else if(/^[0-9]{4}-[0-9]{2}-[0-9]{2}[ T][0-9]{2}:[0-9]{2}/.test(s)){
            const iso = s.replace(" ","T");
            d = new Date(iso.endsWith("Z") ? iso : iso + "Z");
        }
        else if(/^\d{1,2}:\d{2}(:\d{2})?$/.test(s)){
            return s.length === 5 ? `${s}:00` : s;
        }
    }

    if(!d || isNaN(d.getTime()))
        return null;

    return new Intl.DateTimeFormat("es-PE",{
        timeZone:"America/Lima",
        year:"numeric",
        month:"2-digit",
        day:"2-digit",
        hour:"2-digit",
        minute:"2-digit",
        second:"2-digit",
        hour12:false
    }).format(d).replace(",", "");
}


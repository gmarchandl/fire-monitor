<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="Monitor de Incendios Forestales del Perú — FIRMS, VIIRS, MODIS, GOES y datos SERFOR/SNIFFS.">
<meta name="author" content="Monitor de Incendios Perú">
<title>Monitor de Incendios Perú — SERFOR / VIIRS / MODIS / GOES</title>

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>

*{
    box-sizing:border-box
}

html,body{
    margin:0;
    width:100%;
    height:100%;
    font-family:Arial,Helvetica,sans-serif;
    background:#0b1117;
    color:#e8eef5
}

#app{
    width:100%;
    height:100%;
    display:flex;
    flex-direction:column
}

#header{
    height:58px;
    background:linear-gradient(90deg,#101820,#17232d);
    border-bottom:1px solid #293743;
    padding:8px 14px;
    display:flex;
    align-items:center;
    gap:12px;
    z-index:1000
}

#header h1{
    margin:0;
    font-size:18px;
    color:#fff;
    white-space:nowrap
}

#estado{
    margin-left:auto;
    font-size:12px;
    color:#9fb1bf;
    text-align:right
}

#btnActualizar{
    background:#1565c0;
    color:#fff;
    border:0;
    padding:8px 13px;
    border-radius:5px;
    cursor:pointer;
    font-weight:bold
}

#btnActualizar:disabled{
    background:#455a64;
    cursor:wait
}

#panel{
    position:absolute;
    top:68px;
    left:12px;
    width:410px;
    max-height:calc(100vh - 82px);
    overflow-y:auto;
    background:rgba(10,18,25,.96);
    border:1px solid #334554;
    border-radius:8px;
    padding:12px;
    z-index:900;
    box-shadow:0 4px 20px rgba(0,0,0,.5)
}

#panel h2{
    font-size:15px;
    margin:0 0 10px;
    color:#fff
}

.grupo{
    margin-bottom:13px
}

.grupo label{
    display:block;
    font-size:11px;
    color:#90a4ae;
    margin-bottom:4px
}

.grupo input,
.grupo select{
    width:100%;
    background:#101a22;
    border:1px solid #354957;
    color:#fff;
    border-radius:4px;
    padding:8px
}

.btn{
    width:100%;
    padding:8px;
    margin-top:5px;
    border:0;
    border-radius:4px;
    cursor:pointer;
    color:#fff;
    font-weight:bold
}

.btn-verde{background:#087f5b}
.btn-azul{background:#1565c0}
.btn-gris{background:#455a64}
.btn-naranja{background:#ef6c00}

.capa-operativa{
    display:flex;
    align-items:center;
    gap:8px;
    padding:7px;
    margin-bottom:5px;
    background:#101a22;
    border:1px solid #263640;
    border-radius:5px;
    cursor:pointer
}

.capa-operativa:hover{
    background:#16232c
}

.capa-operativa input{
    width:auto
}

.capa-icono{
    width:22px;
    text-align:center;
    font-size:17px
}

.capa-nombre{
    flex:1;
    font-size:12px
}

.stat{
    display:flex;
    justify-content:space-between;
    border-bottom:1px solid #263640;
    padding:5px 0;
    font-size:12px;
    gap:10px
}

.stat span:last-child{
    font-weight:bold;
    color:#fff;
    text-align:right
}

.stat-total{
    background:#13212b;
    border-radius:4px;
    padding-left:5px;
    padding-right:5px;
    margin-top:3px
}

.stat-grupo{
    margin-top:8px;
    margin-bottom:4px;
    padding:5px 7px;
    background:#172631;
    border-left:3px solid #2196f3;
    color:#fff;
    font-size:11px;
    font-weight:bold
}

.stat-satelite{
    display:flex;
    align-items:center;
    gap:6px
}

.sensor-punto{
    width:9px;
    height:9px;
    border-radius:50%;
    display:inline-block;
    flex-shrink:0
}

.sensor-ok{color:#00e676!important}
.sensor-error{color:#ff5252!important}
.sensor-info{color:#ffb300!important}

.criterio{
    background:#101a22;
    border:1px solid #263640;
    border-radius:5px;
    padding:7px;
    margin-bottom:5px;
    font-size:11px
}

.criterio b{color:#fff}

.nota{
    font-size:10px;
    color:#90a4ae;
    line-height:1.4
}

#map{
    flex:1;
    width:100%
}

.popup-resumen{
    margin:8px 0 10px;
    padding:9px 10px;
    border-radius:8px;
    background:#f5f7f9;
    border-left:4px solid #555;
    line-height:1.45;
}
.popup-resumen-titulo{font-weight:800;margin-bottom:5px;}
.popup-detalles{margin-top:8px;}
.popup-detalles summary{cursor:pointer;font-weight:700;padding:5px 0;}
.popup-tab{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:10px;padding:8px 10px;border:1px solid #cbd5e1;border-radius:7px;background:#f8fafc;color:#1e293b;font-weight:800;cursor:pointer;font-size:12px;text-align:left;}
.popup-tab:hover{background:#eef2f7;}
.popup-tab .flecha{transition:transform .15s ease;}
.popup-tab.abierto .flecha{transform:rotate(90deg);}
.popup-tecnico{display:none;margin-top:8px;max-height:45vh;overflow-y:auto;overflow-x:hidden;border-top:1px solid #e2e8f0;padding-top:7px;}
.popup-tecnico.abierto{display:block;}

.popup-incendio{
    color:#111;
    min-width:300px;
    max-width:480px;
    font-size:13px
}

.popup-incendio h3{
    margin:0 0 8px
}

.popup-sensor{
    margin-top:6px;
    background:#f3f5f7;
    border:1px solid #ddd;
    border-radius:5px;
    padding:6px
}

.popup-sensor-row{
    display:flex;
    justify-content:space-between;
    gap:12px;
    border-bottom:1px solid #ddd;
    padding:4px 0
}

.popup-sensor-row:last-child{
    border-bottom:0
}

.badge{
    display:inline-block;
    padding:3px 7px;
    border-radius:10px;
    color:#fff;
    font-size:11px;
    font-weight:bold
}

.badge-alto{background:#d50000}
.badge-medio{background:#ef6c00}
.badge-bajo{background:#1565c0}
.badge-descartado{background:#616161}
/* =========================================================
   POPUPS MOVIBLES
========================================================= */
.leaflet-popup-content-wrapper{cursor:grab;user-select:none;}
.leaflet-popup-content-wrapper.popup-dragging{cursor:grabbing;}
.popup-drag-handle{cursor:grab;touch-action:none;}
.popup-drag-handle:active{cursor:grabbing;}


.icono-foco-serfor{
    width:18px;
    height:18px;
    background:#8B1E3F;
    border:3px solid white;
    border-radius:50%;
    box-shadow:
        0 0 0 3px rgba(139,30,63,.30),
        0 0 12px rgba(139,30,63,.80)
}

.icono-alerta-serfor{
    width:32px;
    height:32px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(211,47,47,.15);
    border:2px solid #d32f2f;
    border-radius:50%;
    font-size:20px;
    box-shadow:
        0 0 0 4px rgba(211,47,47,.20),
        0 0 15px rgba(255,87,34,.70);
    animation:pulsoAlertaSERFOR 1.8s infinite
}

.icono-alerta-serfor span{
    display:inline-block;
    animation:llamaAlerta 1.1s ease-in-out infinite alternate;
    transform-origin:center bottom
}

@keyframes pulsoAlertaSERFOR{
    0%,100%{
        box-shadow:
        0 0 0 3px rgba(211,47,47,.20),
        0 0 8px rgba(255,87,34,.45)
    }

    50%{
        box-shadow:
        0 0 0 9px rgba(211,47,47,.04),
        0 0 22px rgba(255,87,34,.90)
    }
}

@keyframes llamaAlerta{
    from{
        transform:translateY(1px) scale(.92) rotate(-4deg)
    }

    to{
        transform:translateY(-2px) scale(1.08) rotate(4deg)
    }
}

.icono-coordenada{
    font-size:30px;
    filter:drop-shadow(0 2px 3px rgba(0,0,0,.7))
}

.legend{
    background:rgba(15,20,25,.95);
    color:#fff;
    padding:9px;
    border-radius:5px;
    line-height:20px;
    box-shadow:0 2px 8px rgba(0,0,0,.3)
}

.legend-title{
    font-weight:bold;
    margin-bottom:5px;
    border-bottom:1px solid #455a64;
    padding-bottom:4px
}

.legend-item{
    display:flex;
    align-items:center;
    gap:7px;
    cursor:pointer
}

.legend-dot{
    width:10px;
    height:10px;
    border-radius:50%;
    display:inline-block
}

#cargando{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.42);
    z-index:5000;
    align-items:center;
    justify-content:center
}

.spinner-box{
    background:#101820;
    padding:20px;
    border-radius:8px;
    border:1px solid #344957;
    min-width:280px;
    text-align:center
}

.spinner{
    width:28px;
    height:28px;
    border:3px solid #455a64;
    border-top-color:#2196f3;
    border-radius:50%;
    animation:spin .8s linear infinite;
    margin:0 auto 12px
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

@media(max-width:700px){

    #header h1{font-size:14px}

    #estado{display:none}

    #panel{
        width:calc(100vw - 24px);
        max-height:52vh
    }
}


/* ===== MODO MOVIL: SOLO LO ESENCIAL ===== */
@media (max-width: 700px){
  #mobileResumen{position:fixed;top:48px;left:8px;right:8px;z-index:1500;display:grid;grid-template-columns:repeat(4,1fr);gap:5px;background:rgba(20,20,20,.92);padding:6px;border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.35);color:#fff;font-size:10px;text-align:center}
  #mobileResumen div{display:flex;flex-direction:column;line-height:1.2;min-width:0}
  #mobileResumen b{font-size:9px;white-space:nowrap}
  #mobileResumen span{font-size:16px;font-weight:700;margin-top:2px}
  body.mobile-mapa #panel, body.mobile-capas #panel{overflow:hidden}
  body.mobile-capas #panel .grupo{display:none}
  body.mobile-capas #panel .grupo:nth-of-type(3){display:block}
  body.mobile-capas #panel .grupo:nth-of-type(3) .capa-operativa:nth-of-type(n+5){display:none}
  .leaflet-control-layers{font-size:10px!important}
  .legend{display:none!important}
  #map{height:calc(100vh - 58px)!important}
}
@media (min-width:701px){#mobileResumen{display:none}}


.capa-operativa.compacta{min-height:38px;font-size:14px;}
#estadisticas .stat{min-height:32px;}

.map-cluster-legend{position:absolute;z-index:1000;right:10px;bottom:76px;background:rgba(255,255,255,.94);border-radius:8px;padding:7px 9px;box-shadow:0 2px 8px rgba(0,0,0,.22);font:11px Arial,sans-serif;line-height:17px;color:#222}.map-cluster-legend .legend-title{font-weight:700;margin-bottom:2px}.lg-dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px}.lg-alto{background:#d50000}.lg-medio{background:#ef6c00}.lg-bajo{background:#1565c0}
</style>

<style>
.popup-sensor-detalle{
    min-width:320px;
    max-width:430px;
}
.sensor-identificacion{
    padding:8px 10px;
    border-radius:8px;
    background:rgba(0,0,0,.06);
    line-height:1.7;
}
.popup-sensor-grid{
    display:flex;
    flex-direction:column;
    gap:5px;
}
.popup-sensor-row{
    display:grid;
    grid-template-columns:minmax(120px, 1fr) minmax(120px, 1.4fr);
    gap:8px;
    padding:5px 0;
    border-bottom:1px solid rgba(128,128,128,.18);
    font-size:12px;
}
.popup-sensor-row span:last-child{
    text-align:right;
    word-break:break-word;
}
</style>
<meta name="application-name" content="Monitor de Incendios Perú">
<script src="https://unpkg.com/@mapbox/shp-write@0.4.3/shpwrite.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<style>
/* =========================================================
   MODO CELULAR — revisión rápida
   ========================================================= */
#mobileTabs,#mobileQuickBar{display:none}
@media(max-width:700px){
  html,body,#app{width:100%;height:100%;margin:0;overflow:hidden}
  #map{position:fixed!important;inset:48px 0 58px 0!important;height:auto!important;width:100%!important;z-index:1}
  #header{position:fixed!important;top:0!important;left:0!important;right:0!important;height:48px!important;z-index:2100!important;padding:0 10px!important;display:flex!important;align-items:center!important;gap:8px!important;background:rgba(10,20,28,.97)!important}
  #header h1{font-size:13px!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;margin:0!important}
  #header #estado{display:none!important}
  #btnActualizar{font-size:12px!important;padding:7px 9px!important;min-width:auto!important}
  #mobileQuickBar{display:flex;position:fixed;left:8px;right:8px;bottom:68px;z-index:2050;align-items:center;justify-content:space-between;pointer-events:none}
  #mobileQuickBar .quick-title{pointer-events:auto;background:rgba(15,23,32,.90);color:#fff;border-radius:18px;padding:7px 11px;font-size:11px;font-weight:800;box-shadow:0 2px 8px rgba(0,0,0,.35)}
  #mobileRefresh{pointer-events:auto;border:0;border-radius:50%;width:38px;height:38px;background:#1976d2;color:#fff;font-size:22px;box-shadow:0 2px 8px rgba(0,0,0,.35)}
  #mobileTabs{display:flex;position:fixed;bottom:0;left:0;right:0;height:58px;background:rgba(12,20,28,.98);z-index:4000;box-shadow:0 -2px 10px rgba(0,0,0,.35);padding:4px 5px env(safe-area-inset-bottom,4px);gap:4px}
  .mobile-tab{flex:1;border:0;background:transparent;color:#b9c5ce;border-radius:8px;font-size:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px}
  .mobile-tab span{font-size:10px;font-weight:700}
  .mobile-tab.activo{background:#263845;color:#fff}
  #panel{display:none;position:fixed!important;z-index:3500!important;top:54px!important;left:7px!important;right:7px!important;bottom:66px!important;width:auto!important;max-height:none!important;margin:0!important;border-radius:12px!important;overflow:auto!important;background:rgba(15,23,32,.98)!important;box-shadow:0 4px 20px rgba(0,0,0,.5)!important;padding:12px!important}
  body.mobile-capas #panel{display:block}
  body.mobile-mapa #panel{display:none}
  #panel h2{font-size:15px!important;margin:8px 0!important}
  #panel .grupo{margin-bottom:10px}
  /* En móvil: la pestaña Capas solo controla grupos de visualización. */
  body.mobile-capas #panel > *{display:none!important}
  body.mobile-capas #panel > .grupo:nth-of-type(3){display:block!important}
  body.mobile-capas #panel > .grupo:nth-of-type(3) h2{display:block!important}
  body.mobile-capas #panel > .grupo:nth-of-type(3) label{display:flex!important}
  #estadisticas{font-size:12px!important}
  .stat{padding:5px 2px!important}
  .stat-grupo{font-size:11px!important;padding:5px 7px!important;margin-top:7px!important}
  .stat-total{font-weight:800}
  /* quitar descargas en la versión móvil */
  #panel button[onclick*="descargarSHP"],
  #panel button[onclick*="descargarKML"],
  #panel button[onclick*="descargarCSV"]{display:none!important}
  /* popups compactos y desplazables */
  .leaflet-popup-content-wrapper{width:calc(100vw - 20px)!important;max-width:calc(100vw - 20px)!important;max-height:78vh!important;overflow:visible!important}
  .leaflet-popup-content{width:calc(100vw - 40px)!important;max-width:none!important;max-height:72vh!important;overflow:visible!important;margin:8px!important;font-size:12px!important;box-sizing:border-box}
  .popup-sensor-detalle{min-width:0!important;max-width:none!important;width:100%!important}
  .popup-sensor-row{grid-template-columns:1fr 1fr!important;font-size:11px!important}
  .popup-tab{font-size:11px!important;padding:9px!important}
  .popup-tecnico{max-height:52vh!important;overflow-y:auto!important;overflow-x:hidden!important;padding-right:5px!important;box-sizing:border-box}
  .leaflet-control-layers{display:none!important}

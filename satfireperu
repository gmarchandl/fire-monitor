/* =========================================================
   ACTUALIZAR INCENDIOS
========================================================= */

async function actualizarIncendios(){

    if(actualizando)
        return;

    if(!mapKey()){

        estado(
            "⚠️ Falta MAP_KEY de FIRMS"
        );

        return;

    }

    actualizando = true;

    $("btnActualizar").disabled =
        true;

    mostrarCarga(
        true,
        "Consultando FIRMS por sensor..."
    );

    try{

        const all = [];

        let err = 0;

        /* ============================
           VIIRS POR SATÉLITE
        ============================ */

        for(
            const s of CONFIG.FIRMS.SOURCES
        ){

            try{

                mostrarCarga(
                    true,
                    `Consultando ${s.nombre} / ${s.sensor}...`
                );

                const raw =
                    await firms(
                        s.id
                    );

                const normalizados =
                    raw
                    .map(
                        d =>
                        viirs(
                            d,
                            s
                        )
                    )
                    .filter(
                        d => {

                            const x =
                                fechaD(d);

                            return x &&
                                new Intl.DateTimeFormat(
                                    "en-CA",
                                    {
                                        timeZone:"America/Lima",
                                        year:"numeric",
                                        month:"2-digit",
                                        day:"2-digit"
                                    }
                                )
                                .format(x)
                                ===
                                fecha();

                        }
                    );

                all.push(
                    ...normalizados
                );

            }
            catch(e){

                console.error(
                    `Error ${s.id}`,
                    e
                );

                err++;

            }

        }

        datosVIIRSOriginales =
            all;

        const q =
            validar(all);

        datosVIIRS =
            q.v;

        datosVIIRSDescartados =
            q.x;

        /* VIIRS POR SENSOR */

        datosSuomi =
            datosVIIRS.filter(
                d =>
                d.satellite ===
                "Suomi-NPP"
            );

        datosNOAA20 =
            datosVIIRS.filter(
                d =>
                d.satellite ===
                "NOAA-20"
            );

        datosNOAA21 =
            datosVIIRS.filter(
                d =>
                d.satellite ===
                "NOAA-21"
            );

        datosVIIRSOtros =
            datosVIIRS.filter(
                d =>
                ![
                    "Suomi-NPP",
                    "NOAA-20",
                    "NOAA-21"
                ]
                .includes(
                    d.satellite
                )
            );

        sensorEstado(
            "estadoVIIRS",
            err
            ? "PARCIAL"
            : "OK",
            err
            ? "error"
            : "ok"
        );

        /* ============================
           MODIS
        ============================ */

        try{

            mostrarCarga(
                true,
                "Consultando Terra / Aqua — MODIS..."
            );

            datosMODIS =
                (
                    await firms(
                        CONFIG.FIRMS.MODIS
                    )
                )
                .map(
                    d =>
                    normalizarSensor(
                        sensorDato(
                            d,
                            "MODIS"
                        ),
                        "MODIS"
                    )
                );

            sensorEstado(
                "estadoMODIS",
                "OK",
                "ok"
            );

        }
        catch(e){

            console.error(
                "MODIS",
                e
            );

            datosMODIS = [];

            sensorEstado(
                "estadoMODIS",
                "ERROR",
                "error"
            );

        }

        /* ============================
           GOES
        ============================ */

        try{

            mostrarCarga(
                true,
                "Consultando GOES-18 / GOES-19 — ABI..."
            );

            datosGOES =
                (
                    await firms(
                        CONFIG.FIRMS.GOES
                    )
                )
                .map(
                    d =>
                    normalizarSensor(
                        sensorDato(
                            d,
                            "GOES"
                        ),
                        "GOES"
                    )
                );

            sensorEstado(
                "estadoGOES",
                "OK",
                "ok"
            );

        }
        catch(e){

            console.error(
                "GOES",
                e
            );

            datosGOES = [];

            sensorEstado(
                "estadoGOES",
                "ERROR",
                "error"
            );

        }

        /* ============================
           DIBUJAR
        ============================ */

        dibujarVIIRS(
            datosVIIRS
        );

        dibujarDesc(
            datosVIIRSDescartados
        );

        dibujarMODIS(
            datosMODIS
        );

        dibujarGOES(
            datosGOES
        );

        /* ============================
           CLUSTERS
        ============================ */

        const cs = [];

        for(
            const g of
            hacerClusters(
                datosVIIRS
            )
        ){

            const c = {

                ...stats(g),

                modisCercanos:[],
                goesCercanos:[]

            };

            c.modisCercanos =
                cercanos(
                    datosMODIS,
                    c,
                    CONFIG.CORROBORACION.MODIS_M
                );

            c.goesCercanos =
                cercanos(
                    datosGOES,
                    c,
                    CONFIG.CORROBORACION.GOES_M
                );

            Object.assign(
                c,
                score(c)
            );

            cs.push(c);

        }

        clustersGlobal =
            cs;

        dibujarClusters(
            cs
        );

        /* ============================
           ESTADÍSTICA
        ============================ */

        estadistica(cs);

        estado(

            `✓ VIIRS ${datosVIIRS.length}` +
            ` | MODIS ${datosMODIS.length}` +
            ` | GOES ${datosGOES.length}` +
            ` | Clusters ${cs.length}`

        );

    }
    catch(e){

        console.error(e);

        estado(
            "❌ " +
            e.message
        );

    }
    finally{

        actualizando =
            false;

        $("btnActualizar").disabled =
            false;

        mostrarCarga(
            false
        );

    }

}


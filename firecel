async function serfor(id){

    const t0 = performance.now();

    const r =
        await fetch(

            `${CONFIG.SERFOR.REST}/${id}/query` +
            `?where=1%3D1` +
            `&outFields=*` +
            `&returnGeometry=true` +
            `&outSR=4326` +
            `&resultRecordCount=5000` +
            `&f=geojson`,

            {
                cache:"no-store"
            }

        );

    if(!r.ok)
        throw Error(
            `SERFOR HTTP ${r.status}`
        );

    const data = filtrarGeoJSONPeru(await r.json());
    data._consultaMs = Math.round(performance.now() - t0);
    data._serforId = id;
    return data;

}

function popupS(
    f,
    title,
    color
){
    const props=f.properties || {};
    const entries=Object.entries(props).filter(([k,v])=>v!==null&&v!==undefined&&v!=="");

    const pick=(patterns)=>{
        for(const [k,v] of entries){
            if(patterns.some(rx=>rx.test(String(k)))) return [k,v];
        }
        return null;
    };

    const coordX = f.geometry?.coordinates?.[0];
    const coordY = f.geometry?.coordinates?.[1];
    const dep = pick([/departamento/i,/^depto$/i,/region/i]);
    const prov = pick([/provincia/i,/^prov$/i]);
    const dist = pick([/distrito/i,/^dist$/i]);
    const fecha = pick([/fecha.*hora/i,/fecha_hora/i,/datetime/i,/timestamp/i,/fecha/i]);
    const hora = pick([/^hora$/i,/time/i]);

    const resumen=[];
    if(coordY!==undefined && coordX!==undefined) resumen.push(["Coordenadas", `${Number(coordY).toFixed(5)}, ${Number(coordX).toFixed(5)}`]);
    if(dep) resumen.push(["Departamento", valorSERFOR(dep[0],dep[1])]);
    if(prov) resumen.push(["Provincia", valorSERFOR(prov[0],prov[1])]);
    if(dist) resumen.push(["Distrito", valorSERFOR(dist[0],dist[1])]);
    if(fecha) resumen.push(["Fecha / toma", valorSERFOR(fecha[0],fecha[1])]);
    if(hora) resumen.push(["Hora", valorSERFOR(hora[0],hora[1])]);

    // Si no se encontraron campos prioritarios, mostrar los primeros atributos disponibles.
    if(!resumen.length){
        entries.slice(0,5).forEach(([k,v])=>resumen.push([k,valorSERFOR(k,v)]));
    }

    const usadas=new Set(resumen.map(([label])=>label));
    const detalleVals=entries.filter(([k])=>!usadas.has(k)).slice(0,80);

    return `
        <div class="popup-incendio">
            <h3 style="color:${color}">${title}</h3>
            <div class="popup-resumen" style="border-left-color:${color}">
                <div class="popup-resumen-titulo">📋 RESUMEN</div>
                ${resumen.map(([k,v])=>`<div><b>${escHtmlSensor(k)}:</b> ${escHtmlSensor(v)}</div>`).join("")}
            </div>
            ${detalleVals.length ? `<button type="button" class="popup-tab" onclick="togglePopupTech(this)"><span>🔎 Ver información técnica completa</span><span class="flecha">▶</span></button><div class="popup-tecnico">${detalleVals.map(([k,v])=>`<div><b>${escHtmlSensor(k)}:</b> ${escHtmlSensor(valorSERFOR(k,v))}</div>`).join("")}</div>` : ""}
        </div>`;
}


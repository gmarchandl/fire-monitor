/* =========================================================
   EXPORTACIÓN GIS — SHAPEFILE Y KML
   Sustituye la descarga CSV. Exporta los clusters VIIRS
   actualmente calculados por el monitor.
========================================================= */
function datosExportacionGIS(){
    if(!Array.isArray(clustersGlobal) || !clustersGlobal.length) return [];

    return clustersGlobal.map((c,i)=>{
        const mejor = c.mejor || c.detecciones?.[0] || {};
        const lat = Number(c.lat ?? c.latitude ?? mejor.latitude ?? mejor.lat);
        const lon = Number(c.lon ?? c.longitude ?? mejor.longitude ?? mejor.lon);
        if(!Number.isFinite(lat) || !Number.isFinite(lon)) return null;

        const sensores = Object.values(c.sensores || {})
            .map(s => `${s.satelite || ''}/${s.sensor || ''}:${s.total || 0}`)
            .join(' | ');

        return {
            type:'Feature',
            geometry:{type:'Point',coordinates:[lon,lat]},
            properties:{
                ID:i+1,
                FECHA_PERU:String(c.fechaPeru || c.fecha || ''),
                HORA_PERU:String(c.horaPeru || c.hora || ''),
                LATITUD:Number(lat.toFixed(6)),
                LONGITUD:Number(lon.toFixed(6)),
                VIIRS:Number(c.total || c.viirsTotal || c.detecciones?.length || 0),
                SENSORES:String(sensores).slice(0,240),
                FRP_TOTAL:Number(c.frpTotal || 0),
                FRP_MAX:Number(c.frpMax || 0),
                MODIS:Number(c.modisCercanos?.length || 0),
                GOES:Number(c.goesCercanos?.length || 0),
                FIRE_SCORE:Number(c.fireScore || c.score || 0),
                NIVEL:String(c.nivel || ''),
                PRIORIDAD:String(c.prioridad || ''),
                RAZONES:String((c.razonesFire || []).join(' | ')).slice(0,240)
            }
        };
    }).filter(Boolean);
}

function descargarSHP(){
    const features = datosExportacionGIS();
    if(!features.length){
        alert('No existen clusters VIIRS disponibles para exportar. Primero actualice los datos.');
        return;
    }
    if(typeof shpwrite === 'undefined'){
        alert('No se pudo cargar el módulo Shapefile. Revise la conexión a Internet.');
        return;
    }
    const geojson={type:'FeatureCollection',features};
    try{
        const result=shpwrite.zip(geojson,{
            folder:'Monitor_Incendios_Peru',
            types:{point:'clusters_incendios'},
            outputType:'blob',
            compression:'DEFLATE',
            prj:'GEOGCS["WGS 84",DATUM["WGS_1984",SPHEROID["WGS 84",6378137,298.257223563]],PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433]]'
        });
        Promise.resolve(result).then(blob=>{
            if(typeof saveAs==='function') saveAs(blob,'Monitor_Incendios_Peru_Shapefile.zip');
            else{
                const a=document.createElement('a');
                a.href=URL.createObjectURL(blob);
                a.download='Monitor_Incendios_Peru_Shapefile.zip';
                a.click();
                setTimeout(()=>URL.revokeObjectURL(a.href),1000);
            }
        }).catch(err=>{
            console.error(err);
            alert('Error generando Shapefile: '+(err.message || err));
        });
    }catch(err){
        console.error(err);
        alert('Error generando Shapefile: '+(err.message || err));
    }
}

function kmlSafe(v){
    return String(v ?? '')
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&apos;');
}

function descargarKML(){
    const features=datosExportacionGIS();
    if(!features.length){
        alert('No existen clusters VIIRS disponibles para exportar. Primero actualice los datos.');
        return;
    }

    // Icono de fuego estable de Google Earth + tintes KML en formato ABGR.
    // Esto evita las X de iconos externos que no existen o no son compatibles.
    const fireIcon='http://maps.google.com/mapfiles/kml/shapes/firedept.png';
    const styles=`
      <Style id="alto"><IconStyle><color>ff0000ff</color><scale>1.35</scale><Icon><href>${fireIcon}</href></Icon><hotSpot x="0.5" y="0" xunits="fraction" yunits="fraction"/></IconStyle><LabelStyle><scale>0.85</scale></LabelStyle></Style>
      <Style id="medio"><IconStyle><color>ff0080ff</color><scale>1.30</scale><Icon><href>${fireIcon}</href></Icon><hotSpot x="0.5" y="0" xunits="fraction" yunits="fraction"/></IconStyle><LabelStyle><scale>0.85</scale></LabelStyle></Style>
      <Style id="bajo"><IconStyle><color>ff00ffff</color><scale>1.25</scale><Icon><href>${fireIcon}</href></Icon><hotSpot x="0.5" y="0" xunits="fraction" yunits="fraction"/></IconStyle><LabelStyle><scale>0.85</scale></LabelStyle></Style>
      <Style id="otros"><IconStyle><color>ffb0b0b0</color><scale>1.15</scale><Icon><href>${fireIcon}</href></Icon><hotSpot x="0.5" y="0" xunits="fraction" yunits="fraction"/></IconStyle></Style>`;

    const grupos={ALTO:[],MEDIO:[],BAJO:[],OTROS:[]};
    features.forEach(f=>{
        const n=String(f.properties?.NIVEL||'').trim().toUpperCase();
        (grupos[n]||grupos.OTROS).push(f);
    });

    const placemark=(f,styleId)=>{
        const p=f.properties||{}, c=f.geometry.coordinates||[];
        const desc=Object.entries(p).map(([k,v])=>`<b>${kmlSafe(k)}</b>: ${kmlSafe(v)}`).join('<br/>');
        const nivel=kmlSafe(p.NIVEL||'SIN NIVEL');
        return `<Placemark><name>${kmlSafe(p.ID||'Cluster')} — ${nivel}</name><styleUrl>#${styleId}</styleUrl><description><![CDATA[${desc}]]></description><Point><coordinates>${Number(c[0])},${Number(c[1])},0</coordinates></Point></Placemark>`;
    };
    const folder=(name,style,arr)=>arr.length?`<Folder><name>${kmlSafe(name)} (${arr.length})</name>${arr.map(f=>placemark(f,style)).join('')}</Folder>`:'';

    const kml=`<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
<name>Monitor de Incendios Perú — Niveles</name>${styles}
${folder('ALTO — Prioridad máxima','alto',grupos.ALTO)}
${folder('MEDIO — Vigilancia reforzada','medio',grupos.MEDIO)}
${folder('BAJO — Vigilancia','bajo',grupos.BAJO)}
${folder('SIN NIVEL','otros',grupos.OTROS)}
</Document></kml>`;

    try{
        const blob=new Blob([kml],{type:'application/vnd.google-earth.kml+xml;charset=UTF-8'});
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');
        a.href=url;
        a.download='Monitor_Incendios_Peru_KML_por_Nivel.kml';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(()=>URL.revokeObjectURL(url),1500);
    }catch(err){
        console.error('KML',err);
        alert('Error al generar el KML: '+(err.message||err));
    }
}


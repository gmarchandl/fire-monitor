async function refrescarSERFOR(){

    const t0 = performance.now();

    try{

        const resultados =
            await Promise.all([
                serfor(CONFIG.SERFOR.FOCOS),
                serfor(CONFIG.SERFOR.ALERTAS)
            ]);

        const [
            focoData,
            alertaData
        ] = resultados;

        const focos = focoData.features || [];
        const alertas = alertaData.features || [];

        datosFocosSERFOR = focos;
        datosAlertasSERFOR = alertas;

        dibujarS(
            {features:focos},
            capaFocosSERFOR,
            '<div class="icono-foco-serfor"></div>',
            "🔥 FOCO DE CALOR SERFOR",
            "#8B1E3F"
        );

        dibujarS(
            {features:alertas},
            capaAlertasSERFOR,
            '<div class="icono-alerta-serfor"><span>🔥</span></div>',
            "🔥 INCENDIO FORESTAL SERFOR",
            "#d32f2f"
        );

        txt("totalFocosSERFOR", focos.length);
        txt("totalAlertasSERFOR", alertas.length);

        const ultima =
            [
                extraerFechaSERFOR(focos),
                extraerFechaSERFOR(alertas)
            ]
            .filter(Boolean)
            .sort((a,b)=>b-a)[0] || null;

        txt(
            "demoraSERFOR",
            `${Math.round(performance.now() - t0)} ms`
        );

        txt(
            "estadoSERFOR",
            `OK · ${focos.length + alertas.length} registros`
        );

        const ultimaPeru =
            ultima
            ? formatFechaHoraPeru(ultima)
            : null;

        txt(
            "ultimoSERFOR",
            ultimaPeru
            ? `${ultimaPeru} (Perú)`
            : "N/D"
        );

        return true;

    }
    catch(e){

        console.error(
            "SERFOR",
            e
        );

        txt(
            "estadoSERFOR",
            `ERROR · ${e.message}`
        );

        txt(
            "demoraSERFOR",
            `${Math.round(performance.now() - t0)} ms`
        );

        return false;

    }

}


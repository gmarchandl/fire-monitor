function puntoEnPoligonoPeru(lon, lat){
    if(!Number.isFinite(lat) || !Number.isFinite(lon)) return false;
    if(lon < -81.5 || lon > -68.5 || lat < -18.6 || lat > 0.2) return false;
    let dentro = false;
    for(let i=0, j=PERU_COUNTRY_POLYGON.length-1; i<PERU_COUNTRY_POLYGON.length; j=i++){
        const xi=PERU_COUNTRY_POLYGON[i][0], yi=PERU_COUNTRY_POLYGON[i][1];
        const xj=PERU_COUNTRY_POLYGON[j][0], yj=PERU_COUNTRY_POLYGON[j][1];
        const intersect = ((yi > lat) !== (yj > lat)) && (lon < (xj-xi)*(lat-yi)/(yj-yi)+xi);
        if(intersect) dentro=!dentro;
    }
    return dentro;
}

function esPuntoPeruRegistro(d){
    const lat = Number(d?.latitude ?? d?.lat ?? d?.LATITUDE ?? d?.latitud);
    const lon = Number(d?.longitude ?? d?.lon ?? d?.LONGITUDE ?? d?.longitud);
    return puntoEnPoligonoPeru(lon, lat);
}

function filtrarRegistrosPeru(registros){

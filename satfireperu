<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Monitor de Incendios Perú — SERFOR / VIIRS / MODIS / GOES</title>

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>

*{
    box-sizing:border-box
}

html,body{
    margin:0;
    width:100%;
    height:100%;
    font-family:Arial,Helvetica,sans-serif;
    background:#0b1117;
    color:#e8eef5
}

#app{
    width:100%;
    height:100%;
    display:flex;
    flex-direction:column
}

#header{
    height:58px;
    background:linear-gradient(90deg,#101820,#17232d);
    border-bottom:1px solid #293743;
    padding:8px 14px;
    display:flex;
    align-items:center;
    gap:12px;
    z-index:1000
}

#header h1{
    margin:0;
    font-size:18px;
    color:#fff;
    white-space:nowrap
}

#estado{
    margin-left:auto;
    font-size:12px;
    color:#9fb1bf;
    text-align:right
}

#btnActualizar{
    background:#1565c0;
    color:#fff;
    border:0;
    padding:8px 13px;
    border-radius:5px;
    cursor:pointer;
    font-weight:bold
}

#btnActualizar:disabled{
    background:#455a64;
    cursor:wait
}

#panel{
    position:absolute;
    top:68px;
    left:12px;
    width:410px;
    max-height:calc(100vh - 82px);
    overflow-y:auto;
    background:rgba(10,18,25,.96);
    border:1px solid #334554;
    border-radius:8px;
    padding:12px;
    z-index:900;
    box-shadow:0 4px 20px rgba(0,0,0,.5)
}

#panel h2{
    font-size:15px;
    margin:0 0 10px;
    color:#fff
}

.grupo{
    margin-bottom:13px
}

.grupo label{
    display:block;
    font-size:11px;
    color:#90a4ae;
    margin-bottom:4px
}

.grupo input,
.grupo select{
    width:100%;
    background:#101a22;
    border:1px solid #354957;
    color:#fff;
    border-radius:4px;
    padding:8px
}

.btn{
    width:100%;
    padding:8px;
    margin-top:5px;
    border:0;
    border-radius:4px;
    cursor:pointer;
    color:#fff;
    font-weight:bold
}

.btn-verde{background:#087f5b}
.btn-azul{background:#1565c0}
.btn-gris{background:#455a64}
.btn-naranja{background:#ef6c00}

.capa-operativa{
    display:flex;
    align-items:center;
    gap:8px;
    padding:7px;
    margin-bottom:5px;
    background:#101a22;
    border:1px solid #263640;
    border-radius:5px;
    cursor:pointer
}

.capa-operativa:hover{
    background:#16232c
}

.capa-operativa input{
    width:auto
}

.capa-icono{
    width:22px;
    text-align:center;
    font-size:17px
}

.capa-nombre{
    flex:1;
    font-size:12px
}

.stat{
    display:flex;
    justify-content:space-between;
    border-bottom:1px solid #263640;
    padding:5px 0;
    font-size:12px;
    gap:10px
}

.stat span:last-child{
    font-weight:bold;
    color:#fff;
    text-align:right
}

.stat-total{
    background:#13212b;
    border-radius:4px;
    padding-left:5px;
    padding-right:5px;
    margin-top:3px
}

.stat-grupo{
    margin-top:8px;
    margin-bottom:4px;
    padding:5px 7px;
    background:#172631;
    border-left:3px solid #2196f3;
    color:#fff;
    font-size:11px;
    font-weight:bold
}

.stat-satelite{
    display:flex;
    align-items:center;
    gap:6px
}

.sensor-punto{
    width:9px;
    height:9px;
    border-radius:50%;
    display:inline-block;
    flex-shrink:0
}

.sensor-ok{color:#00e676!important}
.sensor-error{color:#ff5252!important}
.sensor-info{color:#ffb300!important}

.criterio{
    background:#101a22;
    border:1px solid #263640;
    border-radius:5px;
    padding:7px;
    margin-bottom:5px;
    font-size:11px
}

.criterio b{color:#fff}

.nota{
    font-size:10px;
    color:#90a4ae;
    line-height:1.4
}

#map{
    flex:1;
    width:100%
}

.popup-incendio{
    color:#111;
    min-width:300px;
    max-width:480px;
    font-size:13px
}

.popup-incendio h3{
    margin:0 0 8px
}

.popup-sensor{
    margin-top:6px;
    background:#f3f5f7;
    border:1px solid #ddd;
    border-radius:5px;
    padding:6px
}

.popup-sensor-row{
    display:flex;
    justify-content:space-between;
    gap:12px;
    border-bottom:1px solid #ddd;
    padding:4px 0
}

.popup-sensor-row:last-child{
    border-bottom:0
}

.badge{
    display:inline-block;
    padding:3px 7px;
    border-radius:10px;
    color:#fff;
    font-size:11px;
    font-weight:bold
}

.badge-alto{background:#d50000}
.badge-medio{background:#ef6c00}
.badge-bajo{background:#1565c0}
.badge-descartado{background:#616161}

.icono-foco-serfor{
    width:18px;
    height:18px;
    background:#8B1E3F;
    border:3px solid white;
    border-radius:50%;
    box-shadow:
        0 0 0 3px rgba(139,30,63,.30),
        0 0 12px rgba(139,30,63,.80)
}

.icono-alerta-serfor{
    width:32px;
    height:32px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(211,47,47,.15);
    border:2px solid #d32f2f;
    border-radius:50%;
    font-size:20px;
    box-shadow:
        0 0 0 4px rgba(211,47,47,.20),
        0 0 15px rgba(255,87,34,.70);
    animation:pulsoAlertaSERFOR 1.8s infinite
}

.icono-alerta-serfor span{
    display:inline-block;
    animation:llamaAlerta 1.1s ease-in-out infinite alternate;
    transform-origin:center bottom
}

@keyframes pulsoAlertaSERFOR{
    0%,100%{
        box-shadow:
        0 0 0 3px rgba(211,47,47,.20),
        0 0 8px rgba(255,87,34,.45)
    }

    50%{
        box-shadow:
        0 0 0 9px rgba(211,47,47,.04),
        0 0 22px rgba(255,87,34,.90)
    }
}

@keyframes llamaAlerta{
    from{
        transform:translateY(1px) scale(.92) rotate(-4deg)
    }

    to{
        transform:translateY(-2px) scale(1.08) rotate(4deg)
    }
}

.icono-coordenada{
    font-size:30px;
    filter:drop-shadow(0 2px 3px rgba(0,0,0,.7))
}

.legend{
    background:rgba(15,20,25,.95);
    color:#fff;
    padding:9px;
    border-radius:5px;
    line-height:20px;
    box-shadow:0 2px 8px rgba(0,0,0,.3)
}

.legend-title{
    font-weight:bold;
    margin-bottom:5px;
    border-bottom:1px solid #455a64;
    padding-bottom:4px
}

.legend-item{
    display:flex;
    align-items:center;
    gap:7px;
    cursor:pointer
}

.legend-dot{
    width:10px;
    height:10px;
    border-radius:50%;
    display:inline-block
}

#cargando{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.42);
    z-index:5000;
    align-items:center;
    justify-content:center
}

.spinner-box{
    background:#101820;
    padding:20px;
    border-radius:8px;
    border:1px solid #344957;
    min-width:280px;
    text-align:center
}

.spinner{
    width:28px;
    height:28px;
    border:3px solid #455a64;
    border-top-color:#2196f3;
    border-radius:50%;
    animation:spin .8s linear infinite;
    margin:0 auto 12px
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

@media(max-width:700px){

    #header h1{font-size:14px}

    #estado{display:none}

    #panel{
        width:calc(100vw - 24px);
        max-height:52vh
    }
}

</style>
</head>

<body>

<div id="app">

<header id="header">

<h1>🔥 MONITOR DE INCENDIOS — PERÚ</h1>

<span id="estado">Inicializando...</span>

<button id="btnActualizar"
        onclick="actualizarIncendios(true)">
Actualizar
</button>

</header>

<div id="panel">

<h2>Configuración y resultados</h2>

<div class="grupo">

<label>FIRMS MAP KEY</label>

<input
    id="mapKey"
    type="password"
    placeholder="Ingrese su MAP_KEY"
    autocomplete="off">

<button
    class="btn btn-azul"
    onclick="guardarMapKey()">
Guardar MAP_KEY
</button>

</div>

<div class="grupo">

<label>📍 Ir a coordenadas</label>

<input
    id="coordLat"
    type="number"
    step="0.000001"
    placeholder="Latitud, ej. -9.190000">

<input
    id="coordLon"
    type="number"
    step="0.000001"
    placeholder="Longitud, ej. -75.015200"
    style="margin-top:5px">

<button class="btn btn-azul"
        onclick="irACoordenada()">
📍 Ir a coordenada
</button>

<button class="btn btn-verde"
        onclick="agregarCoordenada()">
➕ Agregar punto
</button>

<button class="btn btn-gris"
        onclick="limpiarCoordenada()">
🧹 Limpiar punto
</button>

</div>

<div class="grupo">

<h2>🛰️ Capas operativas</h2>

<label class="capa-operativa">
<input type="checkbox"
       id="chkVIIRS"
       onchange="alternarCapa('viirs')">
<span class="capa-icono" style="color:#00e5ff">●</span>
<span class="capa-nombre">VIIRS — todos</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkSuomi"
       onchange="alternarCapa('suomi')">
<span class="capa-icono" style="color:#00e5ff">●</span>
<span class="capa-nombre">Suomi-NPP / VIIRS</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkNOAA20"
       onchange="alternarCapa('noaa20')">
<span class="capa-icono" style="color:#ff1744">●</span>
<span class="capa-nombre">NOAA-20 / VIIRS</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkNOAA21"
       onchange="alternarCapa('noaa21')">
<span class="capa-icono" style="color:#ff6d00">●</span>
<span class="capa-nombre">NOAA-21 / VIIRS</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkVIIRSDescartados"
       onchange="alternarCapa('descartados')">
<span class="capa-icono" style="color:#777">●</span>
<span class="capa-nombre">VIIRS descartados</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkMODIS"
       onchange="alternarCapa('modis')">
<span class="capa-icono" style="color:#ffeb3b">●</span>
<span class="capa-nombre">MODIS — todos</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkTerra"
       onchange="alternarCapa('terra')">
<span class="capa-icono" style="color:#ffeb3b">●</span>
<span class="capa-nombre">Terra / MODIS</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkAqua"
       onchange="alternarCapa('aqua')">
<span class="capa-icono" style="color:#00e676">●</span>
<span class="capa-nombre">Aqua / MODIS</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkGOES"
       onchange="alternarCapa('goes')">
<span class="capa-icono" style="color:#ff9800">●</span>
<span class="capa-nombre">GOES — todos</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkGOES18"
       onchange="alternarCapa('goes18')">
<span class="capa-icono" style="color:#ff9800">●</span>
<span class="capa-nombre">GOES-18 / ABI</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkGOES19"
       onchange="alternarCapa('goes19')">
<span class="capa-icono" style="color:#e040fb">●</span>
<span class="capa-nombre">GOES-19 / ABI</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkSERFORWMS"
       onchange="alternarSERFORWMS()">
<span class="capa-icono" style="color:#ab47bc">▦</span>
<span class="capa-nombre">SERFOR WMS</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkClusters"
       onchange="alternarCapa('clusters')">
<span class="capa-icono" style="color:#d50000">🔥</span>
<span class="capa-nombre">Clusters / incendios clasificados</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkFocosSERFOR"
       onchange="alternarFocosSERFOR()">
<span class="capa-icono" style="color:#8B1E3F">●</span>
<span class="capa-nombre">Focos de calor SERFOR</span>
</label>

<label class="capa-operativa">
<input type="checkbox"
       id="chkAlertasSERFOR"
       onchange="alternarAlertasSERFOR()">
<span class="capa-icono" style="color:#d50000">🔥</span>
<span class="capa-nombre">Incendios Forestales SERFOR</span>
</label>

</div>

<div class="grupo">

<label>Intervalo automático</label>

<select id="intervaloSelect"
        onchange="configurarTemporizador()">

<option value="900000" selected>15 minutos</option>
<option value="1800000">30 minutos</option>
<option value="3600000">60 minutos</option>

</select>

</div>

<h2>📊 Estadística</h2>

<div id="estadisticas">

<div class="stat">
<span>Fecha Perú</span>
<span id="fechaPeru">---</span>
</div>

<div class="stat">
<span>Hora Perú</span>
<span id="horaPeru">---</span>
</div>

<div class="stat">
<span>Hora UTC</span>
<span id="horaUTC">---</span>
</div>

<hr>

<div class="stat-grupo">
🔥 VIIRS — SENSOR
</div>

<div class="stat">
<span class="stat-satelite">
<span class="sensor-punto" style="background:#00e5ff"></span>
Suomi-NPP / VIIRS
</span>
<span id="totalSuomi">0</span>
</div>

<div class="stat">
<span class="stat-satelite">
<span class="sensor-punto" style="background:#ff1744"></span>
NOAA-20 / VIIRS
</span>
<span id="totalNOAA20">0</span>
</div>

<div class="stat">
<span class="stat-satelite">
<span class="sensor-punto" style="background:#ff6d00"></span>
NOAA-21 / VIIRS
</span>
<span id="totalNOAA21">0</span>
</div>

<div class="stat">
<span>Otros / VIIRS</span>
<span id="totalVIIRSOtros">0</span>
</div>

<div class="stat stat-total">
<span><b>Total VIIRS válidos</b></span>
<span id="totalVIIRSValidos">0</span>
</div>

<div class="stat">
<span>VIIRS originales</span>
<span id="totalVIIRSOriginales">0</span>
</div>

<div class="stat">
<span>VIIRS descartados</span>
<span id="totalVIIRSDescartados">0</span>
</div>

<div class="stat">
<span>Estado VIIRS</span>
<span id="estadoVIIRS">---</span>
</div>

<div class="stat-grupo" style="border-left-color:#ffeb3b">
🔥 MODIS — SENSOR
</div>

<div class="stat">
<span class="stat-satelite">
<span class="sensor-punto" style="background:#ffeb3b"></span>
Terra / MODIS
</span>
<span id="totalMODISTerra">0</span>
</div>

<div class="stat">
<span class="stat-satelite">
<span class="sensor-punto" style="background:#00e676"></span>
Aqua / MODIS
</span>
<span id="totalMODISAqua">0</span>
</div>

<div class="stat">
<span>Otros / MODIS</span>
<span id="totalMODISOtros">0</span>
</div>

<div class="stat stat-total">
<span><b>Total MODIS</b></span>
<span id="totalMODIS">0</span>
</div>

<div class="stat">
<span>Estado MODIS</span>
<span id="estadoMODIS">---</span>
</div>

<div class="stat-grupo" style="border-left-color:#ff9800">
🔥 GOES — SENSOR
</div>

<div class="stat">
<span class="stat-satelite">
<span class="sensor-punto" style="background:#ff9800"></span>
GOES-18 / ABI
</span>
<span id="totalGOES18">0</span>
</div>

<div class="stat">
<span class="stat-satelite">
<span class="sensor-punto" style="background:#e040fb"></span>
GOES-19 / ABI
</span>
<span id="totalGOES19">0</span>
</div>

<div class="stat">
<span>Otros / ABI</span>
<span id="totalGOESOtros">0</span>
</div>

<div class="stat stat-total">
<span><b>Total GOES</b></span>
<span id="totalGOES">0</span>
</div>

<div class="stat">
<span>Estado GOES</span>
<span id="estadoGOES">---</span>
</div>

<div class="stat-grupo" style="border-left-color:#00bcd4">
📡 DETALLE GENERAL POR SENSOR
</div>

<div id="estadisticaSensores">
<div class="stat">
<span>Sin datos</span>
<span>0</span>
</div>
</div>

<div class="stat-grupo" style="border-left-color:#8B1E3F">
🌲 SERFOR
</div>

<div class="stat">
<span>Focos SERFOR</span>
<span id="totalFocosSERFOR">0</span>
</div>

<div class="stat">
<span>Alertas SERFOR</span>
<span id="totalAlertasSERFOR">0</span>
</div>

<div class="stat-grupo" style="border-left-color:#d50000">
🔥 CLUSTERS VIIRS
</div>

<div class="stat">
<span>Clusters VIIRS</span>
<span id="totalClusters">0</span>
</div>

<div class="stat">
<span>Incendios ALTO</span>
<span id="totalAlto">0</span>
</div>

<div class="stat">
<span>Incendios MEDIO</span>
<span id="totalMedio">0</span>
</div>

<div class="stat">
<span>Incendios BAJO</span>
<span id="totalBajo">0</span>
</div>

</div>

<hr>

<h2>Criterios VIIRS iniciales</h2>

<div class="criterio">
<b>Coordenadas:</b> latitud y longitud válidas.
</div>

<div class="criterio">
<b>FRP:</b> FRP ≥ 1 MW.
</div>

<div class="criterio">
<b>Confianza:</b> se descarta confianza baja.
</div>

<div class="criterio">
<b>Cluster:</b> ≥ 3 detecciones VIIRS dentro de ≤ 1000 m.
</div>

<div class="criterio">
<b>Tiempo:</b> ventana de 6 horas.
</div>

<div class="criterio">
<b>Corroboración:</b> MODIS ≤ 3 km y GOES ≤ 10 km.
</div>

<p class="nota">
Los umbrales VIIRS son criterios operativos iniciales del monitor.
</p>

<hr>

<h2>Clasificación</h2>

<div class="stat">
<span>ALTO</span>
<span>Score ≥ 12</span>
</div>

<div class="stat">
<span>MEDIO</span>
<span>Score 7–11</span>
</div>

<div class="stat">
<span>BAJO</span>
<span>Score &lt; 7</span>
</div>

<button class="btn btn-verde"
        onclick="descargarCSV()">
📥 Descargar CSV
</button>

<button class="btn btn-gris"
        onclick="centrarPeru()">
🇵🇪 Centrar Perú
</button>

<button class="btn btn-naranja"
        onclick="limpiarDatos()">
🧹 Limpiar detecciones
</button>

</div>

<div id="map"></div>

</div>

<div id="cargando">

<div class="spinner-box">

<div class="spinner"></div>

<b>🔥 Procesando detecciones</b>

<br><br>

<span id="textoCarga">
Consultando FIRMS por sensor...
</span>

</div>

</div>

<script>

"use strict";

/* =========================================================
   CONFIGURACIÓN
========================================================= */

const CONFIG = {

    FIRMS: {

        BASE:
        "https://firms.modaps.eosdis.nasa.gov",

        BBOX:
        "-82,-19,-68,1",

        DAYS:
        2,

        SOURCES: [

            {
                id:"VIIRS_SNPP_NRT",
                nombre:"Suomi-NPP",
                sensor:"VIIRS",
                color:"#00e5ff"
            },

            {
                id:"VIIRS_NOAA20_NRT",
                nombre:"NOAA-20",
                sensor:"VIIRS",
                color:"#ff1744"
            },

            {
                id:"VIIRS_NOAA21_NRT",
                nombre:"NOAA-21",
                sensor:"VIIRS",
                color:"#ff6d00"
            }

        ],

        MODIS:
        "MODIS_NRT",

        GOES:
        "GOES_NRT"

    },

    VIIRS: {

        FRP_MIN_VALIDO:
        1,

        CLUSTER_MIN:
        3,

        CLUSTER_RADIO_M:
        1000,

        CLUSTER_VENTANA_H:
        6,

        FRP_MEDIO:
        10,

        FRP_ALTO:
        30

    },

    SERFOR: {

        REST:
        "https://geo.serfor.gob.pe/geoservicios/rest/services/Servicios_OGC/Unidad_Monitoreo_Satelital/MapServer",

        WMS:
        "https://geo.serfor.gob.pe/geoservicios/services/Servicios_OGC/Unidad_Monitoreo_Satelital/MapServer/WMSServer",

        FOCOS:
        0,

        ALERTAS:
        1

    },

    CORROBORACION: {

        MODIS_M:
        3000,

        GOES_M:
        10000

    }

};

/* =========================================================
   VARIABLES
========================================================= */

const PERU_CENTER =

        if(
            d.satellite === "NOAA-21"
        )
            return "#ff6d00";

        return "#b388ff";

    }

    if(
        d.instrument === "MODIS"
    ){

        if(
            d.satellite === "Terra"
        )
            return "#ffeb3b";

        if(
            d.satellite === "Aqua"
        )
            return "#00e676";

        return "#ffffff";

    }

    if(
        d.instrument === "ABI"
    ){

        if(
            d.satellite === "GOES-18"
        )
            return "#ff9800";

        if(
            d.satellite === "GOES-19"
        )
            return "#e040fb";

        return "#ffffff";

    }

    return "#ffffff";

}


/* =========================================================
   CSV
========================================================= */

function descargarCSV(){

    if(
        !clustersGlobal.length
    ){

        alert(
            "No existen clusters VIIRS."
        );

        return;

    }

    const h =
        "fecha," +
        "latitud," +
        "longitud," +
        "viirs_total," +
        "satelites_viirs," +
        "detalle_sensores," +
        "frp_total," +
        "frp_max," +
        "modis_3km," +
        "modis_sensores," +
        "goes_10km," +
        "goes_sensores," +
        "fire_score," +
        "nivel," +
        "razones";

    const r =
        clustersGlobal.map(

            c => {

                const detalleSensores =
                    Object.values(
                        c.sensores || {}
                    )
                    .map(
                        s =>
                        `${s.satelite}/${s.sensor}:${s.total}`
                    )
                    .join(" | ");

                const modisSensores =
                    c.modisCercanos
                    .reduce(
                        (acc,d) => {

                            const k =
                                d.sensorLabel ||
                                `${d.satellite}/${d.instrument}`;

                            acc[k] =
                                (acc[k] || 0) + 1;

                            return acc;

                        },
                        {}
                    );

                const goesSensores =
                    c.goesCercanos
                    .reduce(
                        (acc,d) => {

                            const k =
                                d.sensorLabel ||
                                `${d.satellite}/${d.instrument}`;

                            acc[k] =
                                (acc[k] || 0) + 1;

                            return acc;

                        },
                        {}
                    );

                const formato =
                    obj =>
                    Object.entries(obj)
                    .map(
                        ([k,v]) =>
                        `${k}:${v}`
                    )
                    .join(" | ");

                return [

                    fecha(),

                    c.latitude,

                    c.longitude,

                    c.size,

                    c.satelites.join(" | "),

                    detalleSensores,

                    c.frpTotal,

                    c.frpMax,

                    c.modisCercanos.length,

                    formato(
                        modisSensores
                    ),

                    c.goesCercanos.length,

                    formato(
                        goesSensores
                    ),

                    c.fireScore,

                    c.nivel,

                    c.razones.join(" | ")

                ]
                .map(
                    v =>
                    `"${String(v ?? "")
                    .replaceAll('"','""')}"`
                )
                .join(",");

            }

        );

    const a =
        document.createElement(
            "a"
        );

    a.href =
        URL.createObjectURL(

            new Blob(

                [
                    "\uFEFF" +
                    [
                        h,
                        ...r
                    ]
                    .join("\n")
                ],

                {
                    type:
                        "text/csv"
                }

            )

        );

    a.download =
        `incendios_peru_sensores_${fecha()}.csv`;

    a.click();

}


/* =========================================================
   POPUPS LEAFLET MOVIBLES
========================================================= */
function hacerPopupMovible(popup){
    if(!popup || !popup._container || popup._container.dataset.movible === "1") return;
    const cont=popup._container;
    const wrapper=cont.querySelector(".leaflet-popup-content-wrapper");
    if(!wrapper) return;
    cont.dataset.movible="1";
    wrapper.classList.add("popup-drag-handle");
    wrapper.style.touchAction="none";
    let dragging=false,startX=0,startY=0,dx=0,dy=0;
    const point=e=>e.touches?e.touches[0]:e;
    const down=e=>{
        if(e.target.closest(".leaflet-popup-close-button,button,input,select,textarea,a")) return;
        const p=point(e);
        dragging=true; startX=p.clientX; startY=p.clientY;
        wrapper.classList.add("popup-dragging");
        if(e.pointerId!==undefined && wrapper.setPointerCapture){try{wrapper.setPointerCapture(e.pointerId);}catch(_) {}}
        e.preventDefault(); e.stopPropagation();
    };
    const move=e=>{
        if(!dragging)return;
        const p=point(e);
        dx += p.clientX-startX; dy += p.clientY-startY;
        startX=p.clientX; startY=p.clientY;
        wrapper.style.transform=`translate3d(${dx}px,${dy}px,0)`;
        e.preventDefault(); e.stopPropagation();
    };
    const up=e=>{
        if(!dragging)return;
        dragging=false; wrapper.classList.remove("popup-dragging");
        if(e&&e.pointerId!==undefined&&wrapper.releasePointerCapture){try{wrapper.releasePointerCapture(e.pointerId);}catch(_) {}}
    };
    if(window.PointerEvent){
        wrapper.addEventListener("pointerdown",down,{passive:false});
        wrapper.addEventListener("pointermove",move,{passive:false});
        wrapper.addEventListener("pointerup",up,{passive:false});
        wrapper.addEventListener("pointercancel",up,{passive:false});
    }else{
        wrapper.addEventListener("mousedown",down); window.addEventListener("mousemove",move,{passive:false}); window.addEventListener("mouseup",up);
        wrapper.addEventListener("touchstart",down,{passive:false}); wrapper.addEventListener("touchmove",move,{passive:false}); wrapper.addEventListener("touchend",up,{passive:false});
    }
}

function activarPopupsMovibles(){
    if(typeof map==="undefined" || !map || map._popupsMoviblesActivados)return;
    map._popupsMoviblesActivados=true;
    map.on("popupopen",e=>setTimeout(()=>hacerPopupMovible(e.popup),0));
}



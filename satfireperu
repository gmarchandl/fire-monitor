function obtenerCapaSensor(d,tipo){

    if(tipo === "VIIRS"){

        if(d.satellite === "Suomi-NPP")
            return capaSuomi;

        if(d.satellite === "NOAA-20")
            return capaNOAA20;

        if(d.satellite === "NOAA-21")
            return capaNOAA21;

        return capaVIIRS;

    }

    if(tipo === "MODIS"){

        if(d.satellite === "Terra")
            return capaTerra;

        if(d.satellite === "Aqua")
            return capaAqua;

        return capaMODIS;

    }

    if(tipo === "GOES"){

        if(d.satellite === "GOES-18")
            return capaGOES18;

        if(d.satellite === "GOES-19")
            return capaGOES19;

        return capaGOES;

    }

    return null;

}


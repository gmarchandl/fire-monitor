</style>

</head>

<body>

<!-- =====================================================
     INTERFAZ MÓVIL — REVISIÓN RÁPIDA
===================================================== -->
<nav id="mobileTabs" aria-label="Navegación móvil">
  <button class="mobile-tab activo" data-tab="mapa">🗺️<span>Mapa</span></button>
  <button class="mobile-tab" data-tab="capas">☰<span>Capas</span></button>
</nav>

<div id="mobileQuickBar">
  <div class="quick-title">🔥 Monitor de Incendios Perú</div>
  <button id="mobileRefresh" type="button" title="Actualizar">↻</button>
</div>
<div id="mobileResumen">
  <div><b>VIIRS</b><span id="mVIIRS">0</span></div>
  <div><b>Clusters</b><span id="mClusters">0</span></div>
  <div><b>Focos SERFOR</b><span id="mFocosSERFOR">0</span></div>
  <div><b>Alertas SERFOR</b><span id="mAlertasSERFOR">0</span></div>
</div>

<div id="app">

<header id="header">

<h1>🔥 MONITOR DE INCENDIOS — PERÚ</h1>

<span id="estado">Inicializando...</span>

<button id="btnActualizar"
        onclick="actualizarIncendios(true)">
Actualizar
</button>

</header>

<div id="panel">

<h2>Configuración y resultados</h2>

<div class="grupo">

<label>FIRMS MAP KEY</label>

<input
    id="mapKey"
    type="password"
    placeholder="Ingrese su MAP_KEY"
    autocomplete="off">

<button
    class="btn btn-azul"
    onclick="guardarMapKey()">
Guardar MAP_KEY
</button>

</div>

<div class="grupo">

<label>📍 Ir a coordenadas</label>

<input
    id="coordLat"
    type="number"
    step="0.000001"
    placeholder="Latitud, ej. -9.190000">

<input
    id="coordLon"
    type="number"
    step="0.000001"
    placeholder="Longitud, ej. -75.015200"
    style="margin-top:5px">

<button class="btn btn-azul"
        onclick="irACoordenada()">
📍 Ir a coordenada
</button>

<button class="btn btn-verde"
        onclick="agregarCoordenada()">
➕ Agregar punto
</button>

<button class="btn btn-gris"
        onclick="limpiarCoordenada()">
🧹 Limpiar punto
</button>

</div>

<div class="grupo">
<h2>🛰️ Capas</h2>
<div style="font-size:11px;color:#aeb9c2;margin-bottom:8px">Controla aquí las fuentes y el fondo del mapa.</div>
<div class="grupo-base-mapa" style="display:flex;gap:5px;margin-bottom:8px">
<button type="button" class="btn btn-gris" id="btnMapaBase" onclick="cambiarBaseMapa('osm')" style="flex:1;padding:7px 4px;font-size:10px">🗺️ Mapa</button>
<button type="button" class="btn btn-gris" id="btnMapaSatelite" onclick="cambiarBaseMapa('sat')" style="flex:1;padding:7px 4px;font-size:10px">🛰️ Satélite</button>
<button type="button" class="btn btn-azul" id="btnMapaHibrido" onclick="cambiarBaseMapa('hy')" style="flex:1;padding:7px 4px;font-size:10px">🌐 Híbrido</button>
</div>

<label class="capa-operativa compacta">
<input type="checkbox" id="chkNOAA" onchange="alternarGrupoMovil('noaa')">
<span class="capa-icono" style="color:#ff1744">🛰️</span>
<span class="capa-nombre">NOAA / VIIRS</span>
</label>

<label class="capa-operativa compacta">
<input type="checkbox" id="chkMODIS" onchange="alternarGrupoMovil('modis')">
<span class="capa-icono" style="color:#ffeb3b">🛰️</span>
<span class="capa-nombre">MODIS</span>
</label>

<label class="capa-operativa compacta">
<input type="checkbox" id="chkGOES" onchange="alternarGrupoMovil('goes')">
<span class="capa-icono" style="color:#ff9800">🛰️</span>
<span class="capa-nombre">GOES</span>
</label>

<label class="capa-operativa compacta">
<input type="checkbox" id="chkClusters" onchange="alternarCapa('clusters')">
<span class="capa-icono">🔥</span>
<span class="capa-nombre">Incendios / Clusters</span>
</label>

<label class="capa-operativa compacta">
<input type="checkbox" id="chkFocosSERFOR" onchange="alternarFocosSERFOR()">
<span class="capa-icono" style="color:#8B1E3F">●</span>
<span class="capa-nombre">Focos SERFOR</span>
</label>

<label class="capa-operativa compacta">
<input type="checkbox" id="chkAlertasSERFOR" onchange="alternarAlertasSERFOR()">
<span class="capa-icono">🔥</span>
<span class="capa-nombre">Alertas SERFOR</span>
</label>
<button class="btn btn-azul" onclick="descargarKML()" style="width:100%;margin-top:8px">🌐 Descargar KML</button>

</div>

<div class="grupo">

<label>Intervalo automático</label>

<select id="intervaloSelect"

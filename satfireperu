/* =========================================================
   VALIDACIÓN VIIRS
========================================================= */

function validar(ds){

    const v = [];
    const x = [];

    ds.forEach(
        d => {

            const r = [];

            if(
                !Number.isFinite(
                    d.latitude
                ) ||
                !Number.isFinite(
                    d.longitude
                )
            ){

                r.push(
                    "Coordenadas inválidas"
                );

            }

            if(
                !Number.isFinite(
                    d.frp
                ) ||
                d.frp < CONFIG.VIIRS.FRP_MIN_VALIDO
            ){

                r.push(
                    "FRP menor a 1 MW o ausente"
                );

            }

            if(
                [
                    "l",
                    "low"
                ]
                .includes(
                    d.confidenceNormalizada
                )
            ){

                r.push(
                    "Confianza baja"
                );

            }

            d._razonesDescarte =
                r;

            (
                r.length
                ? x
                : v
            )
            .push(d);

        }
    );

    return {
        v,
        x
    };

}

/* =========================================================
   DISTANCIA
========================================================= */

function dist(a,b,c,d){

    const R = 6371000;

    const p =
        a *
        Math.PI /
        180;

    const q =
        c *
        Math.PI /
        180;

    const dp =
        (c-a) *
        Math.PI /
        180;

    const dl =
        (d-b) *
        Math.PI /
        180;

    const z =
        Math.sin(dp/2)**2 +
        Math.cos(p) *
        Math.cos(q) *
        Math.sin(dl/2)**2;

    return 2 *
        R *
        Math.atan2(
            Math.sqrt(z),
            Math.sqrt(1-z)
        );

}

/* =========================================================
   DIFERENCIA HORARIA
========================================================= */

function dh(a,b){

    const x =
        fechaD(a);

    const y =
        fechaD(b);

    return x && y
        ? Math.abs(x-y) / 3600000
        : Infinity;

}

/* =========================================================
   CLUSTERS
========================================================= */

function hacerClusters(ds){

    const used =
        new Set();

    const out = [];

    for(
        let i=0;
        i<ds.length;
        i++
    ){

        if(
            used.has(i)
        )
            continue;

        const g =
            [ds[i]];

        used.add(i);

        let c = true;

        while(c){

            c = false;

            for(
                let j=0;
                j<ds.length;
                j++
            ){

                if(
                    used.has(j)
                )
                    continue;

                if(
                    g.some(
                        p =>
                        dist(
                            p.latitude,
                            p.longitude,
                            ds[j].latitude,
                            ds[j].longitude
                        )
                        <=
                        CONFIG.VIIRS.CLUSTER_RADIO_M
                        &&
                        dh(
                            p,
                            ds[j]
                        )
                        <=
                        CONFIG.VIIRS.CLUSTER_VENTANA_H
                    )
                ){

                    g.push(
                        ds[j]
                    );

                    used.add(j);

                    c = true;

                }

            }

        }

        if(
            g.length >=
            CONFIG.VIIRS.CLUSTER_MIN
        ){

            out.push(g);

        }

    }

    return out;

}


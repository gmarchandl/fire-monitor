/* =========================================================
   SERFOR
========================================================= */

async function serfor(id){

    const r =
        await fetch(

            `${CONFIG.SERFOR.REST}/${id}/query` +
            `?where=1%3D1` +
            `&outFields=*` +
            `&returnGeometry=true` +
            `&outSR=4326` +
            `&f=geojson`,

            {
                cache:"no-store"
            }

        );

    if(!r.ok)
        throw Error(
            `SERFOR HTTP ${r.status}`
        );

    return r.json();

}

function popupS(
    f,
    title,
    color
){

    return `

        <div class="popup-incendio">

        <h3 style="color:${color}">
        ${title}
        </h3>

        ${
            Object.entries(
                f.properties || {}
            )
            .slice(0,25)
            .map(
                ([k,v]) =>
                `<b>${k}:</b> ${v}<br>`
            )
            .join("")
        }

        </div>

    `;

}

function dibujarS(
    g,
    layer,
    icon,
    title,
    color
){

    layer.clearLayers();

    (
        g.features || []
    )
    .forEach(
        f => {

            if(
                f.geometry?.type !== "Point"
            )
                return;

            const [
                x,
                y
            ] =
                f.geometry.coordinates;

            L.marker(

                [y,x],

                {

                    icon:
                        L.divIcon(
                            {

                                className:"",
                                html:icon,

                                iconSize:
                                    [32,32],

                                iconAnchor:
                                    [16,16]

                            }
                        )

                }

            )
            .bindPopup(
                popupS(
                    f,
                    title,
                    color
                )
            )
            .addTo(layer);

        }
    );

}

async function cargarS(
    id,
    layer,
    icon,
    title,
    color,
    count
){

    try{

        const g =
            await serfor(id);

        const f =
            g.features || [];

        dibujarS(
            g,
            layer,
            icon,
            title,
            color
        );

        txt(
            count,
            f.length
        );

        return f;

    }
    catch(e){

        txt(
            count,
            "ERROR"
        );

        return [];

    }

}


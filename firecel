function extraerFechaSERFOR(features){

    const candidatos = [];

    (features || []).forEach(f => {
        Object.entries(f.properties || {}).forEach(([k,v]) => {
            if(!esCampoFechaHora(k) || v === null || v === undefined || v === "")
                return;

            const s = String(v).trim();
            if(/^\d{1,2}:\d{2}(:\d{2})?$/.test(s))
                return;

            let d = null;

            if(typeof v === "number" || /^\d{10,13}$/.test(s)){
                const n = Number(v);
                d = new Date(s.length === 10 ? n * 1000 : n);
            }
            else{
                const iso = s.replace(" ","T");
                d = new Date(iso.endsWith("Z") ? iso : iso + "Z");
            }

            if(d && !isNaN(d.getTime()))
                candidatos.push(d);
        });
    });

    return candidatos.length
        ? new Date(Math.max(...candidatos.map(d => d.getTime())))
        : null;
}


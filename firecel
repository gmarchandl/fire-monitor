function csv(t){

    const l =
        t
        .replace(/^\uFEFF/,"")
        .trim()
        .split(/\r?\n/);

    if(l.length < 2)
        return [];

    function p(x){

        let a = [];
        let v = "";
        let q = false;

        for(
            let i=0;
            i<x.length;
            i++
        ){

            const c =
                x[i];

            if(c === '"'){

                if(
                    q &&
                    x[i+1] === '"'
                ){

                    v += '"';
                    i++;

                }
                else{

                    q = !q;

                }

            }
            else if(
                c === "," &&
                !q
            ){

                a.push(
                    v.trim()
                );

                v = "";

            }
            else{

                v += c;

            }

        }

        a.push(
            v.trim()
        );

        return a;

    }

    const h =
        p(l[0])
        .map(
            x =>
            x.toLowerCase()
        );

    return l
        .slice(1)
        .filter(
            x =>
            x.trim()
        )
        .map(
            x =>
            Object.fromEntries(
                p(x).map(
                    (v,i) =>
                    [
                        h[i] ?? `c${i}`,
                        v
                    ]
                )
            )
        );

}


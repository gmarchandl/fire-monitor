/* =========================================================
   ACTUALIZAR INCENDIOS
========================================================= */

async function actualizarIncendios(){
    if(actualizando) return;
    actualizando=true;
    $("btnActualizar").disabled=true;
    mostrarCarga(true,"Cargando resumen rápido...");

    try{
        // PRIORIDAD 1: SERFOR + VIIRS. Se muestran primero para que el mapa responda rápido.
        const [serforOK, viirsResultados] = await Promise.all([
            refrescarSERFOR(),
            Promise.all(CONFIG.FIRMS.SOURCES.map(async s=>{
                try{
                    const raw=await firms(s.id);
                    return raw.map(d=>viirs(d,s)).filter(d=>fechaD(d));
                }catch(e){ console.error(`Error ${s.id}`,e); return []; }
            }))
        ]);

        const allPeru=filtrarRegistrosPeru(viirsResultados.flat());
        datosVIIRSOriginales=allPeru;
        const q=validar(allPeru);
        datosVIIRS=q.v;
        datosVIIRSDescartados=q.x;
        datosSuomi=datosVIIRS.filter(d=>d.satellite==="Suomi-NPP");
        datosNOAA20=datosVIIRS.filter(d=>d.satellite==="NOAA-20");
        datosNOAA21=datosVIIRS.filter(d=>d.satellite==="NOAA-21");
        datosVIIRSOtros=datosVIIRS.filter(d=>!["Suomi-NPP","NOAA-20","NOAA-21"].includes(d.satellite));

        dibujarVIIRS(datosVIIRS);
        // No dibujar fuentes ocultas: solo se cargan cuando se activan desde Capas.
        const cs=[];
        for(const g of hacerClusters(datosVIIRS)){
            const c={...stats(g),modisCercanos:[],goesCercanos:[]};
            Object.assign(c,score(c));
            cs.push(c);
        }
        clustersGlobal=cs;
        dibujarClusters(cs);
        if(map && !map.hasLayer(capaClusters)) capaClusters.addTo(map);
        if(map && !map.hasLayer(capaAlertasSERFOR)) capaAlertasSERFOR.addTo(map);
        if(map && map.hasLayer(capaFocosSERFOR)) map.removeLayer(capaFocosSERFOR);

        estadistica(cs);
        actualizarResumenMovil(cs);
        estado(`✓ VIIRS ${datosVIIRS.length} | Clusters ${cs.length} | Focos ${datosFocosSERFOR.length} | Alertas ${datosAlertasSERFOR.length}`);
        mostrarCarga(false);

        // PRIORIDAD 2: MODIS y GOES en segundo plano. No bloquean la visualización inicial.
        setTimeout(()=>cargarFuentesSecundarias(),50);

    }catch(e){
        console.error(e);
        estado("❌ "+(e.message||e));
        mostrarCarga(false);
    }finally{
        actualizando=false;
        $("btnActualizar").disabled=false;
    }
}

async function cargarFuentesSecundarias(){
    const tareas=[];
    if(!datosMODIS.length) tareas.push(
        firms(CONFIG.FIRMS.MODIS).then(raw=>{
            datosMODIS=raw.map(d=>normalizarSensor(sensorDato(d,"MODIS"),"MODIS")).filter(esPuntoPeruRegistro);
            sensorEstado("estadoMODIS","OK","ok");
            if(document.getElementById("chkMODIS")?.checked) dibujarMODIS(datosMODIS);
        }).catch(e=>{console.error("MODIS",e); datosMODIS=[]; sensorEstado("estadoMODIS","ERROR","error");})
    );
    if(!datosGOES.length) tareas.push(
        firms(CONFIG.FIRMS.GOES).then(raw=>{
            datosGOES=raw.map(d=>normalizarSensor(sensorDato(d,"GOES"),"GOES")).filter(esPuntoPeruRegistro);
            sensorEstado("estadoGOES","OK","ok");
            if(document.getElementById("chkGOES")?.checked) dibujarGOES(datosGOES);
        }).catch(e=>{console.error("GOES",e); datosGOES=[]; sensorEstado("estadoGOES","ERROR","error");})
    );
    await Promise.all(tareas);
    estadistica(clustersGlobal||[]);
}


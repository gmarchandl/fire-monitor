}

/* =========================================================
   VALIDACIÓN VIIRS
========================================================= */

function validar(ds){

    const v = [];
    const x = [];

    ds.forEach(
        d => {

            const r = [];

            if(
                !Number.isFinite(
                    d.latitude
                ) ||
                !Number.isFinite(
                    d.longitude
                )
            ){

                r.push(
                    "Coordenadas inválidas"
                );

            }

            if(
                !Number.isFinite(
                    d.frp
                ) ||
                d.frp < CONFIG.VIIRS.FRP_MIN_VALIDO
            ){

                r.push(
                    "FRP menor a 1 MW o ausente"
                );

            }

            if(
                [
                    "l",
                    "low"
                ]
                .includes(
                    d.confidenceNormalizada
                )
            ){

                r.push(
                    "Confianza baja"
                );

            }

            d._razonesDescarte =
                r;

            (
                r.length
                ? x
                : v
            )
            .push(d);

        }
    );

    return {
        v,
        x
    };

}

/* =========================================================
   DISTANCIA
========================================================= */

function dist(a,b,c,d){

    const R = 6371000;

    const p =
        a *
        Math.PI /
        180;

    const q =
        c *
        Math.PI /
        180;

    const dp =
        (c-a) *
        Math.PI /
        180;

    const dl =
        (d-b) *
        Math.PI /
        180;

    const z =
        Math.sin(dp/2)**2 +
        Math.cos(p) *
        Math.cos(q) *
        Math.sin(dl/2)**2;

    return 2 *
        R *
        Math.atan2(
            Math.sqrt(z),
            Math.sqrt(1-z)
        );

}

/* =========================================================
   DIFERENCIA HORARIA
========================================================= */

function dh(a,b){

    const x =
        fechaD(a);

    const y =
        fechaD(b);

    return x && y
        ? Math.abs(x-y) / 3600000
        : Infinity;

}

/* =========================================================
   CLUSTERS
========================================================= */

function hacerClusters(ds){

    /* Índice espacial: evita comparar cada punto contra todos los demás. */
    const radio = CONFIG.VIIRS.CLUSTER_RADIO_M;
    const latCell = radio / 111000;
    const grid = new Map();

    const key = (lat, lon) => {
        const y = Math.floor(lat / latCell);
        const x = Math.floor(lon / (latCell / Math.max(0.2, Math.cos(lat * Math.PI / 180))));
        return `${y}:${x}`;
    };

    ds.forEach((d,i) => {
        if(!Number.isFinite(d.latitude) || !Number.isFinite(d.longitude)) return;
        const k = key(d.latitude,d.longitude);
        if(!grid.has(k)) grid.set(k,[]);
        grid.get(k).push(i);
    });

    const used = new Set();
    const out = [];

    for(let i=0;i<ds.length;i++){
        if(used.has(i)) continue;
        const first = ds[i];
        if(!Number.isFinite(first.latitude) || !Number.isFinite(first.longitude)){
            used.add(i);
            continue;
        }

        const g = [first];
        used.add(i);
        const queue = [i];

        while(queue.length){
            const pi = queue.pop();
            const p = ds[pi];
            const y = Math.floor(p.latitude / latCell);
            const x = Math.floor(p.longitude / (latCell / Math.max(0.2, Math.cos(p.latitude * Math.PI / 180))));

            for(let dy=-1;dy<=1;dy++){
                for(let dx=-1;dx<=1;dx++){
                    const candidates = grid.get(`${y+dy}:${x+dx}`);
                    if(!candidates) continue;
                    for(const j of candidates){
                        if(used.has(j)) continue;
                        const q = ds[j];
                        if(dh(p,q) <= CONFIG.VIIRS.CLUSTER_VENTANA_H &&
                           dist(p.latitude,p.longitude,q.latitude,q.longitude) <= radio){
                            used.add(j);
                            g.push(q);
                            queue.push(j);
                        }
                    }
                }
            }
        }

        if(g.length >= CONFIG.VIIRS.CLUSTER_MIN) out.push(g);
    }

    return out;
}

/* =========================================================
   RESUMEN POR SENSOR
========================================================= */

function resumenPorSensor(ds){

    const r = {};

    ds.forEach(
        d => {

            const clave =
                d.sensorLabel ||
                `${d.satellite || "N/D"} / ${d.instrument || "N/D"}`;

            if(!r[clave]){

                r[clave] = {

                    satelite:
                        d.satellite ||
                        "N/D",

                    sensor:
                        d.instrument ||
                        "N/D",

                    total:
                        0,

                    frpTotal:
                        0,

                    frpMax:
                        0

                };

            }

            r[clave].total++;

            r[clave].frpTotal +=
                Number(d.frp) || 0;

            r[clave].frpMax =
                Math.max(
                    r[clave].frpMax,
                    Number(d.frp) || 0
                );

        }
    );

    return r;

}

/* =========================================================
   ESTADÍSTICA CLUSTER
========================================================= */

function stats(g){

    let lat = 0;
    let lon = 0;
    let total = 0;
    let max = 0;
    let alta = 0;
    let nom = 0;

    const sats =
        new Set();

    const sensores = {};

    g.forEach(
        d => {

            lat +=
                d.latitude;

            lon +=
                d.longitude;

            total +=
                d.frp || 0;

            max =
                Math.max(
                    max,
                    d.frp || 0
                );

            if(
                [
                    "h",
                    "high"
                ]
                .includes(
                    d.confidenceNormalizada
                )
            )
                alta++;

            if(
                [
                    "n",
                    "nominal"
                ]
                .includes(
                    d.confidenceNormalizada
                )
            )
                nom++;

            sats.add(
                d.satellite
            );

            const clave =
                d.sensorLabel ||
                `${d.satellite} / ${d.instrument}`;

            if(!sensores[clave]){

                sensores[clave] = {

                    satelite:
                        d.satellite,

                    sensor:
                        d.instrument,

                    total:
                        0,

                    frpTotal:
                        0,

                    frpMax:
                        0

                };

            }

            sensores[clave].total++;

            sensores[clave].frpTotal +=
                Number(d.frp) || 0;

            sensores[clave].frpMax =
                Math.max(
                    sensores[clave].frpMax,
                    Number(d.frp) || 0
                );

        }
    );

    lat /= g.length;
    lon /= g.length;

    return {

        latitude:
            lat,

        longitude:
            lon,

        size:
            g.length,

        frpTotal:
            total,

        frpMax:
            max,

        confianzaAlta:
            alta,

        confianzaNominal:
            nom,

        satelites:
            [...sats],

        sensores:

            sensores,

        radioMax:
            Math.max(
                ...g.map(
                    d =>
                    dist(
                        lat,
                        lon,
                        d.latitude,
                        d.longitude
                    )
                )
            )

    };

}

/* =========================================================
   DETECCIONES CERCANAS
========================================================= */

function cercanos(ds,c,m){

    return ds
        .map(
            d => ({

                ...d,

                distancia:
                    dist(
                        c.latitude,
                        c.longitude,
                        d.latitude,
                        d.longitude
                    )

            })
        )
        .filter(
            d =>
            d.distancia <= m
        );

}

/* =========================================================
   SCORE
========================================================= */

function score(c){

    let s = 3;

    let r =
        ["≥3 VIIRS"];

    if(c.size >= 5){

        s += 2;

        r.push("≥5 VIIRS");

    }

    if(c.frpMax >= 10){

        s += 2;

        r.push("FRP ≥10 MW");

    }

    if(c.frpMax >= 30){

        s += 2;

        r.push("FRP ≥30 MW");

    }

    if(c.confianzaAlta){

        s += 3;

        r.push("Confianza alta");

    }
    else if(c.confianzaNominal){

        s++;

        r.push("Confianza nominal");

    }

    if(c.satelites.length >= 2){

        s += 2;

        r.push("≥2 satélites VIIRS");

    }

    if(c.modisCercanos.length){

        s += 2;

        r.push("MODIS ≤3 km");

    }

    if(c.goesCercanos.length){

        s += 2;

        r.push("GOES ≤10 km");

    }

    return {

        fireScore:
            s,

        nivel:
            s >= 12
            ? "ALTO"
            : s >= 7
            ? "MEDIO"
            : "BAJO",

        razones:
            r

    };

}


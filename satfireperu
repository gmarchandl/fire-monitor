/* =========================================================
   NORMALIZACIÓN SENSOR
========================================================= */

function normalizarSensor(d,tipo){

    let satellite =
        String(
            d.satellite ?? ""
        )
        .trim()
        .toUpperCase();

    let instrument =
        String(
            d.instrument ?? ""
        )
        .trim()
        .toUpperCase();

    if(tipo === "VIIRS"){

        if(
            satellite.includes("SNPP") ||
            satellite.includes("NPP") ||
            satellite.includes("SUOMI")
        ){

            satellite = "Suomi-NPP";

        }
        else if(
            satellite.includes("NOAA-20") ||
            satellite.includes("NOAA20") ||
            satellite.includes("N20")
        ){

            satellite = "NOAA-20";

        }
        else if(
            satellite.includes("NOAA-21") ||
            satellite.includes("NOAA21") ||
            satellite.includes("N21")
        ){

            satellite = "NOAA-21";

        }

        instrument = "VIIRS";

    }

    if(tipo === "MODIS"){

        if(
            satellite.includes("TERRA")
        ){

            satellite = "Terra";

        }
        else if(
            satellite.includes("AQUA")
        ){

            satellite = "Aqua";

        }

        instrument = "MODIS";

    }

    if(tipo === "GOES"){

        if(
            satellite.includes("19")
        ){

            satellite = "GOES-19";

        }
        else if(
            satellite.includes("18")
        ){

            satellite = "GOES-18";

        }
        else if(
            satellite.includes("17")
        ){

            satellite = "GOES-17";

        }
        else if(
            satellite.includes("16")
        ){

            satellite = "GOES-16";

        }

        instrument = "ABI";

    }

    if(!satellite)
        satellite = "N/D";

    if(!instrument)
        instrument = tipo || "N/D";

    return {

        ...d,

        satellite,

        instrument,

        sensorLabel:
            `${satellite} / ${instrument}`

    };

}


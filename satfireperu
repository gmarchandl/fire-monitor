function resumenPorSensor(ds){

    const r = {};

    ds.forEach(
        d => {

            const clave =
                d.sensorLabel ||
                `${d.satellite || "N/D"} / ${d.instrument || "N/D"}`;

            if(!r[clave]){

                r[clave] = {

                    satelite:
                        d.satellite ||
                        "N/D",

                    sensor:
                        d.instrument ||
                        "N/D",

                    total:
                        0,

                    frpTotal:
                        0,

                    frpMax:
                        0

                };

            }

            r[clave].total++;

            r[clave].frpTotal +=
                Number(d.frp) || 0;

            r[clave].frpMax =
                Math.max(
                    r[clave].frpMax,
                    Number(d.frp) || 0
                );

        }
    );

    return r;

}

/* =========================================================
   ESTADÍSTICA CLUSTER
========================================================= */

function stats(g){

    let lat = 0;
    let lon = 0;
    let total = 0;
    let max = 0;
    let alta = 0;
    let nom = 0;

    const sats =
        new Set();

    const sensores = {};

    g.forEach(
        d => {

            lat +=
                d.latitude;

            lon +=
                d.longitude;

            total +=
                d.frp || 0;

            max =
                Math.max(
                    max,
                    d.frp || 0
                );

            if(
                [
                    "h",
                    "high"
                ]
                .includes(
                    d.confidenceNormalizada
                )
            )
                alta++;

            if(
                [
                    "n",
                    "nominal"
                ]
                .includes(
                    d.confidenceNormalizada
                )
            )
                nom++;

            sats.add(
                d.satellite
            );

            const clave =
                d.sensorLabel ||
                `${d.satellite} / ${d.instrument}`;

            if(!sensores[clave]){

                sensores[clave] = {

                    satelite:
                        d.satellite,

                    sensor:
                        d.instrument,

                    total:
                        0,

                    frpTotal:
                        0,

                    frpMax:
                        0

                };

            }

            sensores[clave].total++;

            sensores[clave].frpTotal +=
                Number(d.frp) || 0;

            sensores[clave].frpMax =
                Math.max(
                    sensores[clave].frpMax,
                    Number(d.frp) || 0
                );

        }
    );

    lat /= g.length;
    lon /= g.length;

    return {

        latitude:
            lat,

        longitude:
            lon,

        size:
            g.length,

        frpTotal:
            total,

        frpMax:
            max,

        confianzaAlta:
            alta,

        confianzaNominal:
            nom,

        satelites:
            [...sats],

        sensores:

            sensores,

        radioMax:
            Math.max(
                ...g.map(
                    d =>
                    dist(
                        lat,
                        lon,
                        d.latitude,
                        d.longitude
                    )
                )
            )

    };

}

/* =========================================================
   DETECCIONES CERCANAS
========================================================= */

function cercanos(ds,c,m){

    return ds
        .map(
            d => ({

                ...d,

                distancia:
                    dist(
                        c.latitude,
                        c.longitude,
                        d.latitude,
                        d.longitude
                    )

            })
        )
        .filter(
            d =>
            d.distancia <= m
        );

}

/* =========================================================
   SCORE
========================================================= */

function score(c){

    let s = 3;

    let r =
        ["≥3 VIIRS"];

    if(c.size >= 5){

        s += 2;

        r.push("≥5 VIIRS");

    }

    if(c.frpMax >= 10){

        s += 2;

        r.push("FRP ≥10 MW");

    }

    if(c.frpMax >= 30){

        s += 2;

        r.push("FRP ≥30 MW");

    }

    if(c.confianzaAlta){

        s += 3;

        r.push("Confianza alta");

    }
    else if(c.confianzaNominal){

        s++;

        r.push("Confianza nominal");

    }

    if(c.satelites.length >= 2){

        s += 2;

        r.push("≥2 satélites VIIRS");

    }

    if(c.modisCercanos.length){

        s += 2;

        r.push("MODIS ≤3 km");

    }

    if(c.goesCercanos.length){

        s += 2;

        r.push("GOES ≤10 km");

    }

    return {

        fireScore:
            s,

        nivel:
            s >= 12
            ? "ALTO"
            : s >= 7
            ? "MEDIO"
            : "BAJO",

        razones:
            r

    };

}


        lat < -90 ||
        lat > 90 ||
        lon < -180 ||
        lon > 180
    ){

        alert(
            "Ingrese coordenadas válidas."
        );

        return;

    }

    capaCoordenada.clearLayers();

    L.marker(

        [lat,lon],

        {

            icon:
                L.divIcon(
                    {

                        className:"",

                        html:
                            "<div class='icono-coordenada'>📍</div>",

                        iconSize:
                            [35,35],

                        iconAnchor:
                            [17,33]

                    }
                )

        }

    )
    .bindPopup(
        `📍 ${lat.toFixed(6)}, ${lon.toFixed(6)}`
    )
    .addTo(
        capaCoordenada
    )
    .openPopup();

    capaCoordenada.addTo(
        map
    );

    map.setView(
        [lat,lon],
        14
    );

}


<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monitor de Incendios Perú — SERFOR / VIIRS / MODIS / GOES</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;font-family:Arial,Helvetica,sans-serif;background:#0b1117;color:#e8eef5}#app{width:100%;height:100%;display:flex;flex-direction:column}#header{height:58px;background:linear-gradient(90deg,#101820,#17232d);border-bottom:1px solid #293743;padding:8px 14px;display:flex;align-items:center;gap:12px;z-index:1000}#header h1{margin:0;font-size:18px;color:#fff;white-space:nowrap}#estado{margin-left:auto;font-size:12px;color:#9fb1bf;text-align:right}#btnActualizar{background:#1565c0;color:#fff;border:0;padding:8px 13px;border-radius:5px;cursor:pointer;font-weight:bold}#btnActualizar:disabled{background:#455a64;cursor:wait}#panel{position:absolute;top:68px;left:12px;width:390px;max-height:calc(100vh - 82px);overflow-y:auto;background:rgba(10,18,25,.96);border:1px solid #334554;border-radius:8px;padding:12px;z-index:900;box-shadow:0 4px 20px rgba(0,0,0,.5)}#panel h2{font-size:15px;margin:0 0 10px;color:#fff}.grupo{margin-bottom:13px}.grupo label{display:block;font-size:11px;color:#90a4ae;margin-bottom:4px}.grupo input,.grupo select{width:100%;background:#101a22;border:1px solid #354957;color:#fff;border-radius:4px;padding:8px}.btn{width:100%;padding:8px;margin-top:5px;border:0;border-radius:4px;cursor:pointer;color:#fff;font-weight:bold}.btn-verde{background:#087f5b}.btn-azul{background:#1565c0}.btn-gris{background:#455a64}.btn-naranja{background:#ef6c00}.capa-operativa{display:flex;align-items:center;gap:8px;padding:7px;margin-bottom:5px;background:#101a22;border:1px solid #263640;border-radius:5px;cursor:pointer}.capa-operativa:hover{background:#16232c}.capa-operativa input{width:auto}.capa-icono{width:22px;text-align:center;font-size:17px}.capa-nombre{flex:1;font-size:12px}.stat{display:flex;justify-content:space-between;border-bottom:1px solid #263640;padding:5px 0;font-size:12px;gap:10px}.stat span:last-child{font-weight:bold;color:#fff;text-align:right}.sensor-ok{color:#00e676!important}.sensor-error{color:#ff5252!important}.sensor-info{color:#ffb300!important}.criterio{background:#101a22;border:1px solid #263640;border-radius:5px;padding:7px;margin-bottom:5px;font-size:11px}.criterio b{color:#fff}.nota{font-size:10px;color:#90a4ae;line-height:1.4}#map{flex:1;width:100%}.popup-incendio{color:#111;min-width:300px;max-width:460px;font-size:13px}.popup-incendio h3{margin:0 0 8px}.badge{display:inline-block;padding:3px 7px;border-radius:10px;color:#fff;font-size:11px;font-weight:bold}.badge-alto{background:#d50000}.badge-medio{background:#ef6c00}.badge-bajo{background:#1565c0}.badge-descartado{background:#616161}.icono-foco-serfor{width:18px;height:18px;background:#8B1E3F;border:3px solid white;border-radius:50%;box-shadow:0 0 0 3px rgba(139,30,63,.30),0 0 12px rgba(139,30,63,.80)}.icono-alerta-serfor{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:rgba(211,47,47,.15);border:2px solid #d32f2f;border-radius:50%;font-size:20px;box-shadow:0 0 0 4px rgba(211,47,47,.20),0 0 15px rgba(255,87,34,.70);animation:pulsoAlertaSERFOR 1.8s infinite}.icono-alerta-serfor span{display:inline-block;animation:llamaAlerta 1.1s ease-in-out infinite alternate;transform-origin:center bottom}@keyframes pulsoAlertaSERFOR{0%,100%{box-shadow:0 0 0 3px rgba(211,47,47,.20),0 0 8px rgba(255,87,34,.45)}50%{box-shadow:0 0 0 9px rgba(211,47,47,.04),0 0 22px rgba(255,87,34,.90)}}@keyframes llamaAlerta{from{transform:translateY(1px) scale(.92) rotate(-4deg)}to{transform:translateY(-2px) scale(1.08) rotate(4deg)}}.icono-coordenada{font-size:30px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.7))}.legend{background:rgba(15,20,25,.93);color:#fff;padding:9px;border-radius:5px;line-height:20px;box-shadow:0 2px 8px rgba(0,0,0,.3)}#cargando{display:none;position:fixed;inset:0;background:rgba(0,0,0,.42);z-index:5000;align-items:center;justify-content:center}.spinner-box{background:#101820;padding:20px;border-radius:8px;border:1px solid #344957;min-width:280px;text-align:center}.spinner{width:28px;height:28px;border:3px solid #455a64;border-top-color:#2196f3;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 12px}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:700px){#header h1{font-size:14px}#estado{display:none}#panel{width:calc(100vw - 24px);max-height:52vh}}
</style>
</head>
<body>
<div id="app">
<header id="header"><h1>🔥 MONITOR DE INCENDIOS — PERÚ</h1><span id="estado">Inicializando...</span><button id="btnActualizar" onclick="actualizarIncendios(true)">Actualizar</button></header>
<div id="panel">
<h2>Configuración y resultados</h2>
<div class="grupo"><label>FIRMS MAP KEY</label><input id="mapKey" type="password" placeholder="Ingrese su MAP_KEY" autocomplete="off"><button class="btn btn-azul" onclick="guardarMapKey()">Guardar MAP_KEY</button></div>
<div class="grupo"><label>📍 Ir a coordenadas</label><input id="coordLat" type="number" step="0.000001" placeholder="Latitud, ej. -9.190000"><input id="coordLon" type="number" step="0.000001" placeholder="Longitud, ej. -75.015200" style="margin-top:5px"><button class="btn btn-azul" onclick="irACoordenada()">📍 Ir a coordenada</button><button class="btn btn-verde" onclick="agregarCoordenada()">➕ Agregar punto</button><button class="btn btn-gris" onclick="limpiarCoordenada()">🧹 Limpiar punto</button></div>
<div class="grupo"><h2>🛰️ Capas operativas</h2><label class="capa-operativa"><input type="checkbox" id="chkVIIRS" onchange="alternarCapa('viirs')"><span class="capa-icono" style="color:#00e5ff">●</span><span class="capa-nombre">VIIRS válidos</span></label><label class="capa-operativa"><input type="checkbox" id="chkVIIRSDescartados" onchange="alternarCapa('descartados')"><span class="capa-icono" style="color:#777">●</span><span class="capa-nombre">VIIRS descartados</span></label><label class="capa-operativa"><input type="checkbox" id="chkMODIS" onchange="alternarCapa('modis')"><span class="capa-icono" style="color:#ffeb3b">●</span><span class="capa-nombre">MODIS</span></label><label class="capa-operativa"><input type="checkbox" id="chkGOES" onchange="alternarCapa('goes')"><span class="capa-icono" style="color:#ff9800">●</span><span class="capa-nombre">GOES — todos los sensores</span></label><label class="capa-operativa"><input type="checkbox" id="chkSERFORWMS" onchange="alternarSERFORWMS()"><span class="capa-icono" style="color:#ab47bc">▦</span><span class="capa-nombre">SERFOR WMS</span></label><label class="capa-operativa"><input type="checkbox" id="chkClusters" onchange="alternarCapa('clusters')"><span class="capa-icono" style="color:#d50000">🔥</span><span class="capa-nombre">Clusters / incendios clasificados</span></label><label class="capa-operativa"><input type="checkbox" id="chkFocosSERFOR" onchange="alternarFocosSERFOR()"><span class="capa-icono" style="color:#8B1E3F">●</span><span class="capa-nombre">Focos de calor SERFOR</span></label><label class="capa-operativa"><input type="checkbox" id="chkAlertasSERFOR" onchange="alternarAlertasSERFOR()"><span class="capa-icono" style="color:#d50000">🔥</span><span class="capa-nombre">Incendios Forestales SERFOR</span></label></div>
<div class="grupo"><label>Intervalo automático</label><select id="intervaloSelect" onchange="configurarTemporizador()"><option value="900000" selected>15 minutos</option><option value="1800000">30 minutos</option><option value="3600000">60 minutos</option></select></div>
<h2>Estadística</h2><div id="estadisticas"><div class="stat"><span>Fecha Perú</span><span id="fechaPeru">---</span></div><div class="stat"><span>Hora Perú</span><span id="horaPeru">---</span></div><div class="stat"><span>Hora UTC</span><span id="horaUTC">---</span></div><hr><div class="stat"><span>VIIRS</span><span id="estadoVIIRS">---</span></div><div class="stat"><span>VIIRS originales</span><span id="totalVIIRSOriginales">0</span></div><div class="stat"><span>VIIRS válidos</span><span id="totalVIIRSValidos">0</span></div><div class="stat"><span>VIIRS descartados</span><span id="totalVIIRSDescartados">0</span></div><div class="stat"><span>Suomi-NPP</span><span id="totalSuomi">0</span></div><div class="stat"><span>NOAA-20</span><span id="totalNOAA20">0</span></div><div class="stat"><span>NOAA-21</span><span id="totalNOAA21">0</span></div><div class="stat"><span>MODIS</span><span id="estadoMODIS">---</span></div><div class="stat"><span>MODIS detecciones</span><span id="totalMODIS">0</span></div><div class="stat"><span>GOES</span><span id="estadoGOES">---</span></div><div class="stat"><span>GOES detecciones</span><span id="totalGOES">0</span></div><div class="stat"><span>Focos SERFOR</span><span id="totalFocosSERFOR">0</span></div><div class="stat"><span>Alertas SERFOR</span><span id="totalAlertasSERFOR">0</span></div><div class="stat"><span>Clusters VIIRS</span><span id="totalClusters">0</span></div><div class="stat"><span>Incendios ALTO</span><span id="totalAlto">0</span></div><div class="stat"><span>Incendios MEDIO</span><span id="totalMedio">0</span></div><div class="stat"><span>Incendios BAJO</span><span id="totalBajo">0</span></div></div>
<hr><h2>Criterios VIIRS iniciales</h2><div class="criterio"><b>Coordenadas:</b> latitud y longitud válidas.</div><div class="criterio"><b>FRP:</b> FRP ≥ 1 MW.</div><div class="criterio"><b>Confianza:</b> se descarta confianza baja.</div><div class="criterio"><b>Cluster:</b> ≥ 3 detecciones VIIRS dentro de ≤ 1000 m.</div><div class="criterio"><b>Tiempo:</b> ventana de 6 horas.</div><div class="criterio"><b>Corroboración:</b> MODIS ≤ 3 km y GOES ≤ 10 km.</div><p class="nota">Los umbrales VIIRS son criterios operativos iniciales del monitor.</p><hr><h2>Clasificación</h2><div class="stat"><span>ALTO</span><span>Score ≥ 12</span></div><div class="stat"><span>MEDIO</span><span>Score 7–11</span></div><div class="stat"><span>BAJO</span><span>Score &lt; 7</span></div><button class="btn btn-verde" onclick="descargarCSV()">📥 Descargar CSV</button><button class="btn btn-gris" onclick="centrarPeru()">🇵🇪 Centrar Perú</button><button class="btn btn-naranja" onclick="limpiarDatos()">🧹 Limpiar detecciones</button>
</div><div id="map"></div></div><div id="cargando"><div class="spinner-box"><div class="spinner"></div><b>🔥 Procesando detecciones</b><br><br><span id="textoCarga">Consultando FIRMS...</span></div></div>
<script>
"use strict";
const CONFIG={FIRMS:{BASE:"https://firms.modaps.eosdis.nasa.gov",BBOX:"-82,-19,-68,1",DAYS:2,SOURCES:[{id:"VIIRS_SNPP_NRT",nombre:"Suomi-NPP",color:"#00e5ff"},{id:"VIIRS_NOAA20_NRT",nombre:"NOAA-20",color:"#ff1744"},{id:"VIIRS_NOAA21_NRT",nombre:"NOAA-21",color:"#ff6d00"}],MODIS:"MODIS_NRT",GOES:"GOES_NRT"},VIIRS:{FRP_MIN_VALIDO:1,CLUSTER_MIN:3,CLUSTER_RADIO_M:1000,CLUSTER_VENTANA_H:6,FRP_MEDIO:10,FRP_ALTO:30},SERFOR:{REST:"https://geo.serfor.gob.pe/geoservicios/rest/services/Servicios_OGC/Unidad_Monitoreo_Satelital/MapServer",WMS:"https://geo.serfor.gob.pe/geoservicios/services/Servicios_OGC/Unidad_Monitoreo_Satelital/MapServer/WMSServer",FOCOS:0,ALERTAS:1},CORROBORACION:{MODIS_M:3000,GOES_M:10000}};const PERU_CENTER=[-9.19,-75.0152];let map,temporizador,actualizando=false,clustersGlobal=[],datosVIIRS=[],datosVIIRSOriginales=[],datosVIIRSDescartados=[],datosSuomi=[],datosNOAA20=[],datosNOAA21=[],datosMODIS=[],datosGOES=[],datosFocosSERFOR=[],datosAlertasSERFOR=[],wmsSERFOR;let capaVIIRS=L.layerGroup(),capaVIIRSDescartados=L.layerGroup(),capaMODIS=L.layerGroup(),capaGOES=L.layerGroup(),capaClusters=L.layerGroup(),capaFocosSERFOR=L.layerGroup(),capaAlertasSERFOR=L.layerGroup(),capaCoordenada=L.layerGroup();const $=id=>document.getElementById(id),txt=(id,v)=>{if($(id))$(id).textContent=v};
function estado(t){txt("estado",t)}function sensor(id,t,c){if($(id)){$(id).textContent=t;$(id).className=c==="ok"?"sensor-ok":c==="error"?"sensor-error":"sensor-info"}}function fecha(){return new Intl.DateTimeFormat("en-CA",{timeZone:"America/Lima",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date())}function hora(d,tz){return new Intl.DateTimeFormat("es-PE",{timeZone:tz,hour:"2-digit",minute:"2-digit",second:"2-digit",hour12:false}).format(d)}function mapKey(){return $("mapKey").value.trim()}function guardarMapKey(){if(!mapKey())return alert("Ingrese una MAP_KEY válida.");localStorage.setItem("firms_map_key",mapKey());actualizarIncendios(true)}function mostrarCarga(v,t){$("cargando").style.display=v?"flex":"none";if(t)txt("textoCarga",t)}function horaF(v){const s=String(v??"").replace(/\D/g,"").padStart(4,"0").slice(-4);return s?`${s.slice(0,2)}:${s.slice(2)}`:"N/D"}function fechaD(d){if(!d.acq_date)return null;const s=String(d.acq_time??"0000").replace(/\D/g,"").padStart(4,"0").slice(-4),x=new Date(`${d.acq_date}T${s.slice(0,2)}:${s.slice(2)}:00Z`);return isNaN(x)?null:x}
function csv(t){const l=t.replace(/^\uFEFF/,"").trim().split(/\r?\n/);if(l.length<2)return[];function p(x){let a=[],v="",q=false;for(let i=0;i<x.length;i++){const c=x[i];if(c==='"'){if(q&&x[i+1]==='"'){v+='"';i++}else q=!q}else if(c===","&&!q){a.push(v.trim());v=""}else v+=c}a.push(v.trim());return a}const h=p(l[0]).map(x=>x.toLowerCase());return l.slice(1).filter(x=>x.trim()).map(x=>Object.fromEntries(p(x).map((v,i)=>[h[i]??`c${i}`,v])))}async function firms(s){const r=await fetch(`${CONFIG.FIRMS.BASE}/api/area/csv/${encodeURIComponent(mapKey())}/${s}/${CONFIG.FIRMS.BBOX}/${CONFIG.FIRMS.DAYS}`,{cache:"no-store"});if(!r.ok)throw Error(`FIRMS HTTP ${r.status}`);const t=await r.text();if(t.toLowerCase().includes("invalid map key"))throw Error("MAP_KEY inválida");return csv(t)}function viirs(d,s){const t4=Number(d.bright_ti4),t5=Number(d.bright_ti5);return{...d,latitude:Number(d.latitude),longitude:Number(d.longitude),frp:Number(d.frp),t4,t5,deltaT:t4-t5,confidenceNormalizada:String(d.confidence??"").toLowerCase().trim(),satellite:s.nombre,source:s.id}}function sensorDato(d,n){return{...d,latitude:Number(d.latitude),longitude:Number(d.longitude),frp:Number(d.frp)||0,satellite:d.satellite||n,source:d.source||n}}function validar(ds){const v=[],x=[];ds.forEach(d=>{const r=[];if(!Number.isFinite(d.latitude)||!Number.isFinite(d.longitude))r.push("Coordenadas inválidas");if(!Number.isFinite(d.frp)||d.frp<1)r.push("FRP menor a 1 MW o ausente");if(["l","low"].includes(d.confidenceNormalizada))r.push("Confianza baja");d._razonesDescarte=r;(r.length?x:v).push(d)});return{v,x}}function dist(a,b,c,d){const R=6371000,p=a*Math.PI/180,q=c*Math.PI/180,dp=(c-a)*Math.PI/180,dl=(d-b)*Math.PI/180,z=Math.sin(dp/2)**2+Math.cos(p)*Math.cos(q)*Math.sin(dl/2)**2;return 2*R*Math.atan2(Math.sqrt(z),Math.sqrt(1-z))}function dh(a,b){const x=fechaD(a),y=fechaD(b);return x&&y?Math.abs(x-y)/3600000:Infinity}function hacerClusters(ds){const used=new Set(),out=[];for(let i=0;i<ds.length;i++){if(used.has(i))continue;const g=[ds[i]];used.add(i);let c=true;while(c){c=false;for(let j=0;j<ds.length;j++)if(!used.has(j)&&g.some(p=>dist(p.latitude,p.longitude,ds[j].latitude,ds[j].longitude)<=1000&&dh(p,ds[j])<=6)){g.push(ds[j]);used.add(j);c=true}}if(g.length>=3)out.push(g)}return out}function stats(g){let lat=0,lon=0,total=0,max=0,alta=0,nom=0;const sats=new Set;g.forEach(d=>{lat+=d.latitude;lon+=d.longitude;total+=d.frp||0;max=Math.max(max,d.frp||0);if(["h","high"].includes(d.confidenceNormalizada))alta++;if(["n","nominal"].includes(d.confidenceNormalizada))nom++;sats.add(d.satellite)});lat/=g.length;lon/=g.length;return{latitude:lat,longitude:lon,size:g.length,frpTotal:total,frpMax:max,confianzaAlta:alta,confianzaNominal:nom,satelites:[...sats],radioMax:Math.max(...g.map(d=>dist(lat,lon,d.latitude,d.longitude)))}}function cercanos(ds,c,m){return ds.map(d=>({...d,distancia:dist(c.latitude,c.longitude,d.latitude,d.longitude)})).filter(d=>d.distancia<=m)}function score(c){let s=3,r=["≥3 VIIRS"];if(c.size>=5){s+=2;r.push("≥5 VIIRS")}if(c.frpMax>=10){s+=2;r.push("FRP ≥10 MW")}if(c.frpMax>=30){s+=2;r.push("FRP ≥30 MW")}if(c.confianzaAlta){s+=3;r.push("Confianza alta")}else if(c.confianzaNominal){s++;r.push("Confianza nominal")}if(c.satelites.length>=2){s+=2;r.push("≥2 satélites VIIRS")}if(c.modisCercanos.length){s+=2;r.push("MODIS ≤3 km")}if(c.goesCercanos.length){s+=2;r.push("GOES ≤10 km")}return{fireScore:s,nivel:s>=12?"ALTO":s>=7?"MEDIO":"BAJO",razones:r}}
function iniciarMapa(){map=L.map("map",{center:PERU_CENTER,zoom:5});const osm=L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{attribution:"© OpenStreetMap contributors"}).addTo(map),sat=L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",{attribution:"© Esri"}),et=L.tileLayer("https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}",{opacity:.95}),hy=L.layerGroup([sat,et]);wmsSERFOR=L.tileLayer.wms(CONFIG.SERFOR.WMS,{layers:"0,1",format:"image/png",transparent:true,opacity:.55,attribution:"© SERFOR"});L.control.layers({"🗺️ OpenStreetMap":osm,"🛰️ Satélite":sat,"🛰️ Híbrido":hy},{VIIRS:capaVIIRS,"VIIRS descartados":capaVIIRSDescartados,MODIS:capaMODIS,GOES:capaGOES,"SERFOR WMS":wmsSERFOR,Clusters:capaClusters,Coordenada:capaCoordenada,"Focos SERFOR":capaFocosSERFOR,"Alertas SERFOR":capaAlertasSERFOR},{collapsed:false}).addTo(map);leyenda()}
function leyenda(){const l=L.control({position:"bottomright"});l.onAdd=()=>{const d=L.DomUtil.create("div","legend");d.innerHTML="<b>🔥 MONITOR</b><br>Capas activables desde el panel izquierdo";return d};l.addTo(map)}function alternarCapa(t){const m={viirs:capaVIIRS,descartados:capaVIIRSDescartados,modis:capaMODIS,goes:capaGOES,clusters:capaClusters}[t],i={viirs:"chkVIIRS",descartados:"chkVIIRSDescartados",modis:"chkMODIS",goes:"chkGOES",clusters:"chkClusters"}[t];if(!m)return;$(i).checked?m.addTo(map):map.removeLayer(m)}function alternarSERFORWMS(){$("chkSERFORWMS").checked?wmsSERFOR.addTo(map):map.removeLayer(wmsSERFOR)}function dibujarVIIRS(ds){capaVIIRS.clearLayers();ds.forEach(d=>{if(!Number.isFinite(d.latitude)||!Number.isFinite(d.longitude))return;const col=d.source.includes("SNPP")?"#00e5ff":d.source.includes("20")?"#ff1744":"#ff6d00";L.circleMarker([d.latitude,d.longitude],{radius:5,color:col,fillColor:col,fillOpacity:.9}).bindPopup(`<div class="popup-incendio"><h3>🔥 VIIRS VÁLIDO</h3><b>Satélite:</b> ${d.satellite}<br><b>FRP:</b> ${(d.frp||0).toFixed(2)} MW<br><b>Fecha:</b> ${d.acq_date||"N/D"}<br><b>Hora UTC:</b> ${horaF(d.acq_time)}</div>`).addTo(capaVIIRS)})}function dibujarDesc(ds){capaVIIRSDescartados.clearLayers();ds.forEach(d=>Number.isFinite(d.latitude)&&Number.isFinite(d.longitude)&&L.circleMarker([d.latitude,d.longitude],{radius:4,color:"#616161",fillColor:"#9e9e9e",fillOpacity:.45,dashArray:"2 2"}).bindPopup(`<div class="popup-incendio"><h3>⚪ VIIRS DESCARTADO</h3>${d._razonesDescarte.join("<br>")}</div>`).addTo(capaVIIRSDescartados))}function dibujarMODIS(ds){capaMODIS.clearLayers();ds.forEach(d=>Number.isFinite(d.latitude)&&Number.isFinite(d.longitude)&&L.circleMarker([d.latitude,d.longitude],{radius:5,color:"#ffeb3b",fillColor:"#ffeb3b",fillOpacity:.85}).bindPopup(`MODIS — FRP ${(d.frp||0).toFixed(2)} MW`).addTo(capaMODIS))}function dibujarGOES(ds){capaGOES.clearLayers();ds.forEach(d=>Number.isFinite(d.latitude)&&Number.isFinite(d.longitude)&&L.circleMarker([d.latitude,d.longitude],{radius:Math.max(5,Math.min(10,5+(d.frp||0)/50)),color:"#ff6d00",fillColor:"#ff9800",fillOpacity:.85,weight:2}).bindPopup(`<div class="popup-incendio"><h3>🛰️ GOES</h3><b>Satélite:</b> ${d.satellite||"N/D"}<br><b>Producto:</b> ${d.source||"GOES_NRT"}<br><b>FRP:</b> ${(d.frp||0).toFixed(2)} MW<br><b>Fecha:</b> ${d.acq_date||"N/D"}<br><b>Hora UTC:</b> ${horaF(d.acq_time)}</div>`).addTo(capaGOES))}function dibujarClusters(cs){capaClusters.clearLayers();cs.forEach(c=>{const col=c.nivel==="ALTO"?"#d50000":c.nivel==="MEDIO"?"#ef6c00":"#1565c0";L.circleMarker([c.latitude,c.longitude],{radius:11,color:col,fillColor:col,fillOpacity:.78,weight:3}).bindPopup(`<div class="popup-incendio"><h3 style="color:${col}">🔥 INCENDIO ${c.nivel}</h3><b>Fire Score:</b> ${c.fireScore}<br><b>VIIRS:</b> ${c.size}<br><b>FRP máximo:</b> ${c.frpMax.toFixed(2)} MW<br><b>MODIS ≤3 km:</b> ${c.modisCercanos.length}<br><b>GOES ≤10 km:</b> ${c.goesCercanos.length}<hr>${c.razones.join("<br>")}</div>`).addTo(capaClusters)})}
async function serfor(id){const r=await fetch(`${CONFIG.SERFOR.REST}/${id}/query?where=1%3D1&outFields=*&returnGeometry=true&outSR=4326&f=geojson`,{cache:"no-store"});if(!r.ok)throw Error(`SERFOR HTTP ${r.status}`);return r.json()}function popupS(f,title,color){return`<div class="popup-incendio"><h3 style="color:${color}">${title}</h3>${Object.entries(f.properties||{}).slice(0,25).map(([k,v])=>`<b>${k}:</b> ${v}<br>`).join("")}</div>`}function dibujarS(g,layer,icon,title,color){layer.clearLayers();(g.features||[]).forEach(f=>{if(f.geometry?.type!=="Point")return;const [x,y]=f.geometry.coordinates;L.marker([y,x],{icon:L.divIcon({className:"",html:icon,iconSize:[32,32],iconAnchor:[16,16]})}).bindPopup(popupS(f,title,color)).addTo(layer)})}async function cargarS(id,layer,icon,title,color,count){try{const g=await serfor(id);const f=g.features||[];dibujarS(g,layer,icon,title,color);txt(count,f.length);return f}catch(e){txt(count,"ERROR");return[]}}function alternarFocosSERFOR(){if($("chkFocosSERFOR").checked){capaFocosSERFOR.addTo(map);if(!datosFocosSERFOR.length)cargarS(0,capaFocosSERFOR,'<div class="icono-foco-serfor"></div>',"🔥 FOCO DE CALOR SERFOR","#8B1E3F","totalFocosSERFOR").then(x=>datosFocosSERFOR=x)}else map.removeLayer(capaFocosSERFOR)}function alternarAlertasSERFOR(){if($("chkAlertasSERFOR").checked){capaAlertasSERFOR.addTo(map);if(!datosAlertasSERFOR.length)cargarS(1,capaAlertasSERFOR,'<div class="icono-alerta-serfor"><span>🔥</span></div>',"🔥 INCENDIO FORESTAL SERFOR","#d32f2f","totalAlertasSERFOR").then(x=>datosAlertasSERFOR=x)}else map.removeLayer(capaAlertasSERFOR)}
function estadistica(cs){const a=new Date();txt("fechaPeru",fecha());txt("horaPeru",hora(a,"America/Lima"));txt("horaUTC",hora(a,"UTC"));txt("totalVIIRSOriginales",datosVIIRSOriginales.length);txt("totalVIIRSValidos",datosVIIRS.length);txt("totalVIIRSDescartados",datosVIIRSDescartados.length);txt("totalSuomi",datosSuomi.length);txt("totalNOAA20",datosNOAA20.length);txt("totalNOAA21",datosNOAA21.length);txt("totalMODIS",datosMODIS.length);txt("totalGOES",datosGOES.length);txt("totalClusters",cs.length);txt("totalAlto",cs.filter(c=>c.nivel==="ALTO").length);txt("totalMedio",cs.filter(c=>c.nivel==="MEDIO").length);txt("totalBajo",cs.filter(c=>c.nivel==="BAJO").length)}
async function actualizarIncendios(){if(actualizando)return;if(!mapKey()){estado("⚠️ Falta MAP_KEY de FIRMS");return}actualizando=true;$("btnActualizar").disabled=true;mostrarCarga(true,"Consultando FIRMS...");try{const all=[];let err=0;for(const s of CONFIG.FIRMS.SOURCES){try{all.push(...(await firms(s.id)).map(d=>viirs(d,s)).filter(d=>{const x=fechaD(d);return x&&new Intl.DateTimeFormat("en-CA",{timeZone:"America/Lima",year:"numeric",month:"2-digit",day:"2-digit"}).format(x)===fecha()}))}catch(e){err++}}datosVIIRSOriginales=all;const q=validar(all);datosVIIRS=q.v;datosVIIRSDescartados=q.x;datosSuomi=datosVIIRS.filter(d=>d.source.includes("SNPP"));datosNOAA20=datosVIIRS.filter(d=>d.source.includes("20"));datosNOAA21=datosVIIRS.filter(d=>d.source.includes("21"));sensor("estadoVIIRS",err?"PARCIAL":"OK",err?"error":"ok");try{datosMODIS=(await firms(CONFIG.FIRMS.MODIS)).map(d=>sensorDato(d,"MODIS"));sensor("estadoMODIS","OK","ok")}catch(e){datosMODIS=[];sensor("estadoMODIS","ERROR","error")}try{datosGOES=(await firms(CONFIG.FIRMS.GOES)).map(d=>sensorDato(d,"GOES"));sensor("estadoGOES","OK","ok")}catch(e){datosGOES=[];sensor("estadoGOES","ERROR","error")}dibujarVIIRS(datosVIIRS);dibujarDesc(datosVIIRSDescartados);dibujarMODIS(datosMODIS);dibujarGOES(datosGOES);const cs=[];for(const g of hacerClusters(datosVIIRS)){const c={...stats(g),modisCercanos:[],goesCercanos:[]};c.modisCercanos=cercanos(datosMODIS,c,3000);c.goesCercanos=cercanos(datosGOES,c,10000);Object.assign(c,score(c));cs.push(c)}clustersGlobal=cs;dibujarClusters(cs);estadistica(cs);estado(`✓ ${datosVIIRS.length} válidos / ${datosVIIRSOriginales.length} originales / ${datosVIIRSDescartados.length} descartados | ${datosGOES.length} GOES`)}catch(e){estado("❌ "+e.message)}finally{actualizando=false;$("btnActualizar").disabled=false;mostrarCarga(false)}}function configurarTemporizador(){clearInterval(temporizador);temporizador=setInterval(actualizarIncendios,Number($("intervaloSelect").value))}function centrarPeru(){map.setView(PERU_CENTER,5)}function irACoordenada(){const lat=Number($("coordLat").value),lon=Number($("coordLon").value);if(!Number.isFinite(lat)||!Number.isFinite(lon)||lat<-90||lat>90||lon<-180||lon>180)return alert("Ingrese coordenadas válidas.");capaCoordenada.clearLayers();L.marker([lat,lon],{icon:L.divIcon({className:"",html:"<div class='icono-coordenada'>📍</div>",iconSize:[35,35],iconAnchor:[17,33]})}).bindPopup(`📍 ${lat.toFixed(6)}, ${lon.toFixed(6)}`).addTo(capaCoordenada).openPopup();capaCoordenada.addTo(map);map.setView([lat,lon],14)}function agregarCoordenada(){irACoordenada()}function limpiarCoordenada(){capaCoordenada.clearLayers()}function limpiarDatos(){[capaVIIRS,capaVIIRSDescartados,capaMODIS,capaGOES,capaClusters].forEach(c=>c.clearLayers());datosVIIRS=[];datosVIIRSOriginales=[];datosVIIRSDescartados=[];datosMODIS=[];datosGOES=[];clustersGlobal=[];estadistica([]);estado("Mapa limpiado")}function descargarCSV(){if(!clustersGlobal.length)return alert("No existen clusters VIIRS.");const h="fecha,latitud,longitud,viirs,frp_max,modis_3km,goes_10km,fire_score,nivel,razones",r=clustersGlobal.map(c=>[fecha(),c.latitude,c.longitude,c.size,c.frpMax,c.modisCercanos.length,c.goesCercanos.length,c.fireScore,c.nivel,c.razones.join(" | ")].map(v=>`"${String(v??"").replaceAll('"','""')}"`).join(",")),a=document.createElement("a");a.href=URL.createObjectURL(new Blob(["\uFEFF"+[h,...r].join("\n")],{type:"text/csv"}));a.download=`incendios_peru_${fecha()}.csv`;a.click()}
setInterval(()=>{const a=new Date();txt("fechaPeru",fecha());txt("horaPeru",hora(a,"America/Lima"));txt("horaUTC",hora(a,"UTC"))},1000);document.addEventListener("DOMContentLoaded",()=>{iniciarMapa();const k=localStorage.getItem("firms_map_key");if(k)$("mapKey").value=k;configurarTemporizador();estadistica([]);estado(k?"Consultando datos...":"Esperando MAP_KEY...");if(k)actualizarIncendios()});
</script>
